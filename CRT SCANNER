                   c1Start,
                   startTime+(datetime)(PeriodSeconds(crtTF)*2),
                   c1Price,
                   (bull ? InpBullCRTLineColor : InpBearCRTLineColor),
                   tfName+" CRT*");

      if(InpEnableCISD && InpDrawCISDLevels &&
         g_states[i].setupCisdPrice>0.0)

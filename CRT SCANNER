   {ObjectsDeleteAll(0,name);return;}
   int index=MAFindFrame(Symbol(),(ENUM_TIMEFRAMES)Period());
   if(index<0)
   {
      DrawTextBlock(name,"GLORYALGO PRICE ACTION\nCurrent chart timeframe: NOT CHECKED",
                    12,18,13,Chart_Label_Size,Neutral_Analysis_Color,"Consolas",
                    CORNER_RIGHT_UPPER,ANCHOR_RIGHT_UPPER,false);
      return;
   }
   MAFrame f=g_maFrames[index];
   bool checked=(f.state!=MA_STATE_INSUFFICIENT && f.lastClosedBar>0);
   string text="GLORYALGO | PRICE ACTION CHECK\n";

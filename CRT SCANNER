void MADrawPriceAction()
{
   if(!Show_Price_Action_On_Chart || !Show_Market_Analysis)
   {
      ObjectsDeleteAll(0,PA_PREFIX);
      g_paVisualSignature="";
      return;
   }
   string signature=Symbol()+"|"+IntegerToString(Period());
   for(int i=0;i<g_maFrameCount;i++)
   {
      if(g_maFrames[i].symbol!=Symbol()) continue;
      if(!Show_All_Timeframes && g_maFrames[i].tf!=(ENUM_TIMEFRAMES)Period()) continue;
      signature+="|"+PATFCode(g_maFrames[i].tf)+":"+IntegerToString((long)g_maFrames[i].lastClosedBar);
   }
   if(signature==g_paVisualSignature) {PADrawStatusPanel();return;}
   g_paVisualSignature=signature;
   for(int i=0;i<g_maFrameCount;i++)
   {
      if(g_maFrames[i].symbol!=Symbol()) continue;
      if(!Show_All_Timeframes && g_maFrames[i].tf!=(ENUM_TIMEFRAMES)Period()) continue;
      if(Show_Major_Swings || Show_Small_Swings)
         PADrawHistoricalSwings(g_maFrames[i].tf);
      PADrawFrameVisuals(g_maFrames[i]);
   }
   PADrawStatusPanel();
   ChartRedraw(0);
}


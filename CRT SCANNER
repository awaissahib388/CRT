// MT5 text labels cannot show line breaks, so a multi-line text block is
// drawn as one label per line (and stale lines are removed).
void DrawTextBlock(string baseName,string text,int x,int y,int lineHeight,
                   int fontSize,color clr,string font,
                   ENUM_BASE_CORNER corner,ENUM_ANCHOR_POINT anchor,
                   bool bottomAlign)
{
   string lines[];
   int n=StringSplit(text,'\n',lines);

   if(n<=0)
      return;

   if(bottomAlign)
   {
      int chartH=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
      y=MathMax(20,chartH-(n*lineHeight)-30);
   }

   ObjectDelete(0,baseName);   // old single-label version

   for(int k=0;k<n;k++)
   {
      string name=baseName+"_L"+IntegerToString(k);

      if(ObjectFind(0,name)<0)
         if(!ObjectCreate(0,name,OBJ_LABEL,0,0,0))
            continue;

      ObjectSetInteger(0,name,OBJPROP_CORNER,corner);
      ObjectSetInteger(0,name,OBJPROP_ANCHOR,anchor);
      ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
      ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y+(k*lineHeight));
      ObjectSetInteger(0,name,OBJPROP_FONTSIZE,fontSize);
      ObjectSetInteger(0,name,OBJPROP_COLOR,clr);
      ObjectSetString(0,name,OBJPROP_FONT,font);
      ObjectSetString(0,name,OBJPROP_TEXT,lines[k]);
      ObjectSetInteger(0,name,OBJPROP_BACK,false);
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
   }

   // Remove lines left over from a longer previous text.
   for(int k=n;k<80;k++)
   {
      string name=baseName+"_L"+IntegerToString(k);

      if(ObjectFind(0,name)<0)
         break;

      ObjectDelete(0,name);
   }
}


//------------------------- CRT CLASSIFICATION ----------------------//
ENUM_CRT_SIGNAL ClassifyCRT(const MqlRates &c1,
                            const MqlRates &c2)
{
   bool sweptHigh=(c2.high>c1.high);
   bool sweptLow=(c2.low<c1.low);

   if(sweptHigh && sweptLow)
   {
      // Strict CRT: a candle that sweeps BOTH sides has no clear
      // false side, so it is never a directional CRT.
      if(InpStrictCRT)
         return CRT_DOUBLE;

      if(c2.close>c1.high)
         return CRT_BULL;

      if(c2.close<c1.low)
         return CRT_BEAR;

      if(c2.close>=c1.low && c2.close<=c1.high)
         return CRT_DOUBLE;

      return CRT_NONE;
   }

   if(sweptHigh && c2.close<c1.high)
      return CRT_BEAR;

   if(sweptLow && c2.close>c1.low)
      return CRT_BULL;

   return CRT_NONE;
}

//------------------------- FIND NEAREST HTF STATE ------------------//
int FindNearestHigherState(int stateIndex)
{
   ENUM_TIMEFRAMES currentTF=g_states[stateIndex].timeframe;
   int currentSeconds=PeriodSeconds(currentTF);

   if(currentSeconds<=0)
      return -1;

   int bestIndex=-1;
   int bestSeconds=0;

   string symbol=g_states[stateIndex].symbol;

   for(int t=0;t<g_timeframeCount;t++)
   {
      int candidateSeconds=PeriodSeconds(g_timeframes[t]);

      if(candidateSeconds<=currentSeconds)
         continue;

      if(bestSeconds==0 || candidateSeconds<bestSeconds)
      {
         bestSeconds=candidateSeconds;
         bestIndex=-1;

         for(int i=0;i<g_stateCount;i++)
         {
            if(g_states[i].symbol==symbol &&
               g_states[i].timeframe==g_timeframes[t])
            {
               bestIndex=i;
               break;
            }
         }
      }
   }

   return bestIndex;
}

//------------------------- FIND NEAREST HIGHER TF ------------------//
ENUM_TIMEFRAMES FindNearestHigherTF(ENUM_TIMEFRAMES currentTF)
{
   int currentSeconds=PeriodSeconds(currentTF);
   int bestSeconds=0;
   ENUM_TIMEFRAMES bestTF=PERIOD_CURRENT;

   for(int i=0;i<g_timeframeCount;i++)
   {
      int seconds=PeriodSeconds(g_timeframes[i]);

      if(seconds<=currentSeconds)
         continue;

      if(bestSeconds==0 || seconds<bestSeconds)
      {
         bestSeconds=seconds;
         bestTF=g_timeframes[i];
      }
   }

   return bestTF;
}

//------------------------- FVG PERMISSION --------------------------//
bool IsFVGDirectionPermitted(ENUM_FVG_PERMISSION permission,
                             bool bullishFVG)
{
   if(permission==FVG_PERMISSION_BOTH)
      return true;

   if(bullishFVG && permission==FVG_PERMISSION_BULLISH)
      return true;

   if(!bullishFVG && permission==FVG_PERMISSION_BEARISH)
      return true;

   return false;
}

//------------------------- FVG ZONE VALIDITY -----------------------//
bool IsFVGStillValid(const MqlRates &rates[],
                     int fvgIndex,
                     bool bullish,
                     double zoneLow,
                     double zoneHigh,
                     datetime evaluationTime,
                     ENUM_TIMEFRAMES tf)
{
   int seconds=PeriodSeconds(tf);

   if(seconds<=0)
      return false;

   // Series array: index 0 is newest.
   // Only candles fully closed by evaluationTime can invalidate.
   for(int j=fvgIndex-1;j>=0;j--)
   {
      datetime candleClose=rates[j].time+seconds;

      if(candleClose>evaluationTime)
         continue;

      if(bullish && rates[j].low<=zoneLow)
         return false;

      if(!bullish && rates[j].high>=zoneHigh)
         return false;
   }

   return true;
}

//------------------------- CHECK HTF FVG TOUCH ---------------------//
bool FindHTFFVGTouch(string symbol,
                     ENUM_TIMEFRAMES htf,
                     const MqlRates &c2,
                     ENUM_FVG_PERMISSION permission)
{
   if(permission==FVG_PERMISSION_NONE)
      return false;

   int lookback=InpFVGLookback;

   if(lookback<5)
      lookback=5;

   MqlRates htfRates[];
   ArraySetAsSeries(htfRates,true);

   int copied=CopyRates(symbol,htf,0,lookback+5,htfRates);

   if(copied<5)
      return false;

   int htfSeconds=PeriodSeconds(htf);

   if(htfSeconds<=0)
      return false;

   int maxIndex=(int)MathMin(lookback,copied-3);

   for(int i=1;i<=maxIndex;i++)
   {
      int older=i+2;

      // The third candle must have closed before C2 began.
      datetime formedTime=htfRates[i].time+htfSeconds;

      if(formedTime>c2.time)
         continue;

      bool bullishFVG=
         (htfRates[older].high < htfRates[i].low);

      bool bearishFVG=
         (htfRates[older].low > htfRates[i].high);

      if(!bullishFVG && !bearishFVG)
         continue;

      if(bullishFVG &&
         !IsFVGDirectionPermitted(permission,true))
         continue;

      if(bearishFVG &&
         !IsFVGDirectionPermitted(permission,false))
         continue;

      double zoneLow=0.0;
      double zoneHigh=0.0;

      if(bullishFVG)
      {
         zoneLow=htfRates[older].high;
         zoneHigh=htfRates[i].low;
      }
      else
      {
         zoneLow=htfRates[i].high;
         zoneHigh=htfRates[older].low;
      }

      if(!IsFVGStillValid(
            htfRates,
            i,
            bullishFVG,
            zoneLow,
            zoneHigh,
            c2.time,
            htf))
         continue;

      bool touches=
         (c2.high>=zoneLow && c2.low<=zoneHigh);

      if(touches)
         return true;
   }

   return false;
}

//------------------------- CHECK CRT FVG QUALIFICATION -------------//
bool CheckCRTFVG(int stateIndex,
                 ENUM_CRT_SIGNAL signal,
                 const MqlRates &c2)
{
   if(signal==CRT_NONE)
      return false;

   int htfIndex=FindNearestHigherState(stateIndex);

   if(htfIndex<0)
      return false;

   ENUM_TIMEFRAMES htf=g_states[htfIndex].timeframe;
   string symbol=g_states[stateIndex].symbol;

   if(signal==CRT_BULL)
      return FindHTFFVGTouch(symbol,htf,c2,
                             InpBullCRT_FVGPermission);

   if(signal==CRT_BEAR)
      return FindHTFFVGTouch(symbol,htf,c2,
                             InpBearCRT_FVGPermission);

   if(signal==CRT_DOUBLE)
   {
      bool bullTouch=FindHTFFVGTouch(
         symbol,htf,c2,InpBullCRT_FVGPermission
      );

      bool bearTouch=FindHTFFVGTouch(
         symbol,htf,c2,InpBearCRT_FVGPermission
      );

      return (bullTouch || bearTouch);
   }

   return false;
}

//------------------------- FVG FILTER WRAPPER ----------------------//
bool IsCRTQualifiedByFVG(int stateIndex,
                         ENUM_CRT_SIGNAL signal,
                         const MqlRates &c2)
{
   if(!InpEnableFVGFilter)
      return true;

   return CheckCRTFVG(stateIndex,signal,c2);
}

//------------------------- CISD DETECTION --------------------------//
void ResetCISDState(int stateIndex)
{
   g_states[stateIndex].cisdReferenceFound=false;
   g_states[stateIndex].cisdConfirmed=false;

   g_states[stateIndex].cisdReferenceTime=0;
   g_states[stateIndex].cisdConfirmationTime=0;
   g_states[stateIndex].cisdReferencePrice=0.0;
}

struct CISDResult
{
   bool     extremeFound;
   datetime extremeTime;
   double   extremePrice;

   bool     refFound;
   datetime refTime;
   double   refPrice;

   bool     confirmed;
   datetime confTime;

   bool     slBreached;   // price traded beyond the C2 extreme afterwards
   bool     tpHit;        // price reached the opposite C1 extreme afterwards

   double   confClose;    // close of the CISD confirmation candle (planned entry)
};

void ResetCISDResult(CISDResult &r)
{
   r.extremeFound=false;
   r.extremeTime=0;
   r.extremePrice=0.0;

   r.refFound=false;
   r.refTime=0;
   r.refPrice=0.0;

   r.confirmed=false;
   r.confTime=0;

   r.slBreached=false;
   r.tpHit=false;

   r.confClose=0.0;
}

// Generic CISD calculation for ANY C2 (completed or still forming).
//
// Bullish CRT (C2 swept the low):
//  - Find the LTF candle with the lowest low inside C2.
//  - Look LEFT of it for the first candle that closed UP.
//  - That candle's CLOSE is the CISD level.
//  - CISD is confirmed when a later, fully closed LTF candle closes
//    ABOVE that level.
// Bearish CRT: mirrored (highest high, first candle that closed DOWN,
// confirmation = close BELOW the level).
//
// It also reports whether price has traded beyond the C2 extreme
// (stop loss) or reached tpPrice since that extreme was made.
bool ComputeCISD(string symbol,
                 ENUM_TIMEFRAMES crtTF,
                 ENUM_CRT_SIGNAL signal,
                 datetime c2Time,
                 double tpPrice,
                 CISDResult &res)
{
   ResetCISDResult(res);

   if(signal!=CRT_BULL && signal!=CRT_BEAR)
      return false;

   if(c2Time<=0)
      return false;

   ENUM_TIMEFRAMES ltf=GetCISDTimeframe(crtTF);

   if(ltf==PERIOD_CURRENT)
      return false;

   int ltfSeconds=PeriodSeconds(ltf);
   int crtSeconds=PeriodSeconds(crtTF);

   if(ltfSeconds<=0 || crtSeconds<=0 ||
      ltfSeconds>=crtSeconds)
      return false;

   datetime c2End=c2Time+crtSeconds;
   datetime now=TimeCurrent();

   int lookbackCRTs=InpCISDLookbackCRTCandles;

   if(lookbackCRTs<1)
      lookbackCRTs=1;

   // Start earlier than C2 so the reference candle can sit
   // to the left of C2 (inside C1 or before it).
   datetime scanStart=
      c2Time-(datetime)(crtSeconds*lookbackCRTs);

   MqlRates rates[];
   ArraySetAsSeries(rates,false);   // index 0 = oldest

   int copied=CopyRates(symbol,ltf,scanStart,now,rates);

   if(copied<3)
      return false;

   // 1) LTF candle that made the C2 extreme (only candles inside C2).
   int extremeIndex=-1;
   double extremePrice=
      (signal==CRT_BEAR ? -DBL_MAX : DBL_MAX);

   for(int i=0;i<copied;i++)
   {
      if(rates[i].time<c2Time)
         continue;

      if(rates[i].time>=c2End)
         break;

      if(signal==CRT_BEAR)
      {
         if(rates[i].high>extremePrice)
         {
            extremePrice=rates[i].high;
            extremeIndex=i;
         }
      }
      else
      {
         if(rates[i].low<extremePrice)
         {
            extremePrice=rates[i].low;
            extremeIndex=i;
         }
      }
   }

   if(extremeIndex<0)
      return false;

   res.extremeFound=true;
   res.extremeTime=rates[extremeIndex].time;
   res.extremePrice=extremePrice;

   // 2) Stop loss / take profit touched after the extreme.
   for(int i=extremeIndex+1;i<copied;i++)
   {
      if(signal==CRT_BULL)
      {
         if(rates[i].low<extremePrice)
            res.slBreached=true;

         if(tpPrice>0.0 && rates[i].high>=tpPrice)
            res.tpHit=true;
      }
      else
      {
         if(rates[i].high>extremePrice)
            res.slBreached=true;

         if(tpPrice>0.0 && rates[i].low<=tpPrice)
            res.tpHit=true;
      }
   }

   // 3) First opposing-side closing candle to the LEFT of the extreme.
   int referenceIndex=-1;

   for(int i=extremeIndex-1;i>=0;i--)
   {
      bool closedUp=(rates[i].close>rates[i].open);
      bool closedDown=(rates[i].close<rates[i].open);

      if(signal==CRT_BULL && closedUp)
      {
         referenceIndex=i;
         break;
      }

      if(signal==CRT_BEAR && closedDown)
      {
         referenceIndex=i;
         break;
      }
   }

   if(referenceIndex<0)
      return true;

   res.refFound=true;
   res.refTime=rates[referenceIndex].time;
   res.refPrice=rates[referenceIndex].close;

   // 4) Confirmation: a later, fully closed candle closes through it.
   for(int i=extremeIndex+1;i<copied;i++)
   {
      datetime candleClose=rates[i].time+ltfSeconds;

      if(candleClose>now)
         continue;

      bool through=(signal==CRT_BEAR ?
                    rates[i].close<res.refPrice :
                    rates[i].close>res.refPrice);

      if(through)
      {
         res.confirmed=true;
         res.confTime=rates[i].time;
         res.confClose=rates[i].close;

         break;
      }
   }

   return true;
}

// CISD of the latest CONFIRMED CRT (used for the chart CISD line).
void UpdateCISD(int stateIndex)
{
   if(!InpEnableCISD)
   {
      ResetCISDState(stateIndex);
      return;
   }

   ENUM_CRT_SIGNAL signal=g_states[stateIndex].confirmedSignal;

   if(signal!=CRT_BULL && signal!=CRT_BEAR)
   {
      ResetCISDState(stateIndex);
      return;
   }

   CISDResult r;

   if(!ComputeCISD(g_states[stateIndex].symbol,
                   g_states[stateIndex].timeframe,
                   signal,
                   g_states[stateIndex].confirmedC2Time,
                   0.0,
                   r) ||
      !r.refFound)
   {
      ResetCISDState(stateIndex);
      return;
   }

   g_states[stateIndex].cisdReferenceFound=true;
   g_states[stateIndex].cisdReferenceTime=r.refTime;
   g_states[stateIndex].cisdReferencePrice=r.refPrice;
   g_states[stateIndex].cisdConfirmed=r.confirmed;
   g_states[stateIndex].cisdConfirmationTime=r.confTime;
}

//------------------------- HISTORY REMOVE -------------------------//
void RemoveCRTFromHistory(int index)
{
   if(index<0 || index>=g_crtHistoryCount)
      return;

   for(int i=index;i<g_crtHistoryCount-1;i++)
      g_crtHistory[i]=g_crtHistory[i+1];

   g_crtHistoryCount--;

   ArrayResize(g_crtHistory,g_crtHistoryCount);
}

//------------------------- HISTORY ADD -----------------------------//
void AddCRTToHistory(int stateIndex,
                     ENUM_CRT_SIGNAL signal,
                     const MqlRates &c1,
                     const MqlRates &c2,
                     datetime c3Time,
                     datetime c3EndTime)
{
   if(signal==CRT_NONE)
      return;

   for(int i=0;i<g_crtHistoryCount;i++)
   {
      if(g_crtHistory[i].symbol==
            g_states[stateIndex].symbol &&
         g_crtHistory[i].timeframe==
            g_states[stateIndex].timeframe &&
         g_crtHistory[i].c2Time==c2.time)
      {
         return;
      }
   }

   int limit=InpRecentCRTHistoryPerTF;

   if(limit<1)
      limit=1;

   ArrayResize(g_crtHistory,g_crtHistoryCount+1);

   int newIndex=g_crtHistoryCount;

   g_crtHistory[newIndex].symbol=
      g_states[stateIndex].symbol;

   g_crtHistory[newIndex].timeframe=
      g_states[stateIndex].timeframe;

   g_crtHistory[newIndex].signal=signal;

   g_crtHistory[newIndex].c2Time=c2.time;
   g_crtHistory[newIndex].c3Time=c3Time;
   g_crtHistory[newIndex].c3EndTime=c3EndTime;

   g_crtHistory[newIndex].c1High=c1.high;
   g_crtHistory[newIndex].c1Low=c1.low;

   g_crtHistory[newIndex].c2Open=c2.open;
   g_crtHistory[newIndex].c2High=c2.high;
   g_crtHistory[newIndex].c2Low=c2.low;

   g_crtHistory[newIndex].c1Open=c1.open;
   g_crtHistory[newIndex].c1Close=c1.close;
   g_crtHistory[newIndex].c2Close=c2.close;

   g_crtHistoryCount++;

   int matchingCount=0;

   for(int i=0;i<g_crtHistoryCount;i++)
   {
      if(g_crtHistory[i].symbol==
            g_states[stateIndex].symbol &&
         g_crtHistory[i].timeframe==
            g_states[stateIndex].timeframe)
      {
         matchingCount++;
      }
   }

   while(matchingCount>limit)
   {
      for(int i=0;i<g_crtHistoryCount;i++)
      {
         if(g_crtHistory[i].symbol==
               g_states[stateIndex].symbol &&
            g_crtHistory[i].timeframe==
               g_states[stateIndex].timeframe)
         {
            RemoveCRTFromHistory(i);
            matchingCount--;
            break;
         }
      }
   }
}

//------------------------- BUILD INITIAL HISTORY -------------------//
void BuildInitialCRTHistory()
{
   ArrayResize(g_crtHistory,0);
   g_crtHistoryCount=0;

   int historyLimit=InpRecentCRTHistoryPerTF;

   if(historyLimit<1)
      historyLimit=1;

   int barsToCopy=500;

   if(historyLimit*20+20>barsToCopy)
      barsToCopy=historyLimit*20+20;

   for(int state=0;state<g_stateCount;state++)
   {
      string symbol=g_states[state].symbol;
      ENUM_TIMEFRAMES tf=g_states[state].timeframe;

      MqlRates rates[];
      ArraySetAsSeries(rates,true);

      int copied=CopyRates(symbol,tf,0,barsToCopy,rates);

      if(copied<4)
         continue;

      for(int c2Index=copied-2;c2Index>=1;c2Index--)
      {
         int c1Index=c2Index+1;
         int c3Index=c2Index-1;

         if(c1Index>=copied || c3Index<0)
            continue;

         ENUM_CRT_SIGNAL signal=
            ClassifyCRT(rates[c1Index],rates[c2Index]);

         if(signal==CRT_NONE)
            continue;

         datetime c3Time=rates[c3Index].time;
         datetime c3End=
            c3Time+PeriodSeconds(tf);

         AddCRTToHistory(
            state,
            signal,
            rates[c1Index],
            rates[c2Index],
            c3Time,
            c3End
         );
      }
   }
}

//------------------------- SETUP EVALUATION ------------------------//
// A setup is a CRT candidate (completed OR still forming) that has
//  1) swept ONE side of C1 and made a C2 extreme,
//  2) confirmed CISD on the mapped lower timeframe,
//  3) touched a valid HTF FVG (always for early setups),
//  4) a planned reward:risk of at least InpMinRR,
//  5) reached the required confluence score.
// It stays active until price trades beyond the C2 extreme (stop loss),
// reaches the target (optional), or the setup expires.
//
// Planned trade (fixed when CISD confirms, so it never "moves"):
//   Entry = close of the CISD confirmation candle
//   SL    = C2 extreme (the sweep)
//   TP    = opposite C1 extreme (TP2 only)
struct CRTCandidate
{
   ENUM_CRT_SIGNAL dir;
   datetime c2Time;
   double   c1Open;
   double   c1High;
   double   c1Low;
   double   c1Close;
   double   c2Open;
   double   c2High;
   double   c2Low;
   double   c2Close;
   bool     early;
};

struct SetupEval
{
   bool   valid;
   int    closeReason;     // 0 none, 1 stop loss hit, 2 target hit
   int    score;
   bool   cfHTF;
   bool   cfLiquidity;
   bool   cfLiqPool;
   bool   cfLiqSession;
   bool   cfLiqRejection;
   int    kzId;
   bool   cfTrend;
   bool   cfSMT;
   double entry;
   double sl;
   double tp2;
   double rr;
   datetime extremeTime;
   datetime cisdTime;
   double   cisdPrice;
   datetime formTime;
};

int MaxSetupScore()
{
   int m=0;
   if(InpUseHTFCRTConfluence) m++;
   if(InpUseKillzones)        m++;
   // Previous day/week and session sweeps are one combined point.
   if(InpUseLiquiditySweep || InpUseSessionLiquidity) m++;
   if(InpUseLiquidityPools)   m++;
   if(InpUseSMT)              m++;
   return m;
}

bool InHourWindow(double hour,int startHour,int endHour)
{
   if(startHour==endHour)
      return false;

   if(startHour<endHour)
      return (hour>=startHour && hour<endHour);

   return (hour>=startHour || hour<endHour);
}

// 1 = London killzone, 2 = New York killzone, 0 = none.
int KillzoneId(datetime serverTime)
{
   int offset=(int)(TimeTradeServer()-TimeGMT());
   offset=((int)MathRound(offset/900.0))*900;

   datetime gmt=serverTime-offset;

   MqlDateTime dt;
   TimeToStruct(gmt,dt);

   double hour=dt.hour+(dt.min/60.0);

   if(InHourWindow(hour,InpLondonStartGMT,InpLondonEndGMT))
      return 1;

   if(InHourWindow(hour,InpNYStartGMT,InpNYEndGMT))
      return 2;

   return 0;
}

// Bull CRT: C2 took out the previous day/week LOW.
// Bear CRT: C2 took out the previous day/week HIGH.
bool CheckLiquiditySweep(int stateIndex,
                         ENUM_CRT_SIGNAL dir,
                         datetime c2Time,
                         double c2High,
                         double c2Low)
{
   string symbol=g_states[stateIndex].symbol;
   ENUM_TIMEFRAMES tf=g_states[stateIndex].timeframe;
   if(tf==PERIOD_W1 || tf==PERIOD_MN1)
      return false;

   // Check the most recently completed daily and weekly reference candles.
   ENUM_TIMEFRAMES refs[2]={PERIOD_D1,PERIOD_W1};
   for(int r=0;r<2;r++)
   {
      int shift=iBarShift(symbol,refs[r],c2Time,false);
      if(shift<0)
         continue;

      MqlRates prev[];
      ArraySetAsSeries(prev,true);
      if(CopyRates(symbol,refs[r],shift+1,1,prev)<1)
         continue;

      if(dir==CRT_BULL && c2Low<prev[0].low)
         return true;
      if(dir==CRT_BEAR && c2High>prev[0].high)
         return true;
   }
   return false;
}

// Detect a sweep of a confirmed swing or a cluster of equal highs/lows.
// The C2 must trade beyond the level and close back through it.
bool CheckLiquidityPoolSweep(int stateIndex,ENUM_CRT_SIGNAL dir,
                              datetime c2Time,double c2High,double c2Low,
                              double c2Close)
{
   string symbol=g_states[stateIndex].symbol;
   ENUM_TIMEFRAMES tf=g_states[stateIndex].timeframe;
   int lookback=InpLiquidityLookback;
   if(lookback<12) lookback=12;
   if(lookback>200) lookback=200;

   MqlRates rates[];
   ArraySetAsSeries(rates,true);
   int c2Shift=iBarShift(symbol,tf,c2Time,false);
   if(c2Shift<0) return false;
   int copied=CopyRates(symbol,tf,c2Shift,lookback+8,rates);
   if(copied<8) return false;

   double point=SymbolInfoDouble(symbol,SYMBOL_POINT);
   double avgRange=0.0;
   int avgCount=0;
   for(int i=1;i<copied && i<=20;i++)
   {
      avgRange+=(rates[i].high-rates[i].low);
      avgCount++;
   }
   if(avgCount<=0) return false;
   avgRange/=avgCount;
   double tolerance=MathMax(point*2.0,avgRange*MathMax(0.01,InpLiquidityToleranceATR));

   if(dir==CRT_BULL)
   {
      // Equal lows: at least two prior lows clustered near the swept level.
      int equalCount=0;
      double cluster=0.0;
      for(int i=1;i<copied && i<=lookback;i++)
      {
         if(rates[i].low>c2Low && rates[i].low-c2Low<=tolerance*2.0)
         {
            equalCount++;
            cluster+=rates[i].low;
         }
      }
      if(equalCount>=2 && c2Close>cluster/equalCount)
         return true;

      // Confirmed swing low: two candles on either side are already closed.
      for(int i=3;i<copied-2 && i<=lookback;i++)
      {
         bool pivot=(rates[i].low<rates[i-1].low && rates[i].low<rates[i-2].low &&
                     rates[i].low<=rates[i+1].low && rates[i].low<=rates[i+2].low);
         if(pivot && c2Low<rates[i].low && c2Close>rates[i].low)
            return true;
      }
   }
   else if(dir==CRT_BEAR)
   {
      int equalCount=0;
      double cluster=0.0;
      for(int i=1;i<copied && i<=lookback;i++)
      {
         if(rates[i].high<c2High && c2High-rates[i].high<=tolerance*2.0)
         {
            equalCount++;
            cluster+=rates[i].high;
         }
      }
      if(equalCount>=2 && c2Close<cluster/equalCount)
         return true;

      for(int i=3;i<copied-2 && i<=lookback;i++)
      {
         bool pivot=(rates[i].high>rates[i-1].high && rates[i].high>rates[i-2].high &&
                     rates[i].high>=rates[i+1].high && rates[i].high>=rates[i+2].high);
         if(pivot && c2High>rates[i].high && c2Close<rates[i].high)
            return true;
      }
   }
   return false;
}

// Session range sweep. Session times are GMT; broker/server offset is
// derived from the same server-to-GMT conversion used by KillzoneId().
bool CheckSessionLiquiditySweep(int stateIndex,ENUM_CRT_SIGNAL dir,
                                datetime c2Time,double c2High,double c2Low,
                                double c2Close)
{
   string symbol=g_states[stateIndex].symbol;
   ENUM_TIMEFRAMES tf=g_states[stateIndex].timeframe;
   int seconds=PeriodSeconds(tf);
   if(seconds<=0 || seconds>=PeriodSeconds(PERIOD_D1)) return false;

   int offset=(int)(TimeTradeServer()-TimeGMT());
   offset=((int)MathRound(offset/900.0))*900;
   datetime gmtC2=c2Time-offset;
   MqlDateTime day;
   TimeToStruct(gmtC2,day);
   day.hour=0; day.min=0; day.sec=0;
   datetime gmtDay=StructToTime(day);
   datetime serverStart=gmtDay+offset;

   MqlRates rates[];
   ArraySetAsSeries(rates,false);
   int copied=CopyRates(symbol,tf,serverStart-86400,c2Time,rates);
   if(copied<2) return false;

   double asiaHigh=-DBL_MAX,asiaLow=DBL_MAX;
   double londonHigh=-DBL_MAX,londonLow=DBL_MAX;
   double priorNYHigh=-DBL_MAX,priorNYLow=DBL_MAX;
   double nyHigh=-DBL_MAX,nyLow=DBL_MAX;
   bool hasAsia=false,hasLondon=false,hasPriorNY=false,hasNY=false;
   for(int i=0;i<copied;i++)
   {
      if(rates[i].time>=c2Time)
         continue;
      datetime barGMT=rates[i].time-offset;
      MqlDateTime bt;
      TimeToStruct(barGMT,bt);
      double hour=bt.hour+(bt.min/60.0);
      if(barGMT>=gmtDay-86400 && barGMT<gmtDay && InHourWindow(hour,InpNYStartGMT,InpNYEndGMT))
      {
         priorNYHigh=MathMax(priorNYHigh,rates[i].high);
         priorNYLow=MathMin(priorNYLow,rates[i].low);
         hasPriorNY=true;
      }
      else if(barGMT>=gmtDay && InHourWindow(hour,InpAsiaStartGMT,InpAsiaEndGMT))
      {
         asiaHigh=MathMax(asiaHigh,rates[i].high);
         asiaLow=MathMin(asiaLow,rates[i].low);
         hasAsia=true;
      }
      else if(barGMT>=gmtDay && InHourWindow(hour,InpLondonStartGMT,InpLondonEndGMT))
      {
         londonHigh=MathMax(londonHigh,rates[i].high);
         londonLow=MathMin(londonLow,rates[i].low);
         hasLondon=true;
      }
      else if(barGMT>=gmtDay && InHourWindow(hour,InpNYStartGMT,InpNYEndGMT))
      {
         nyHigh=MathMax(nyHigh,rates[i].high);
         nyLow=MathMin(nyLow,rates[i].low);
         hasNY=true;
      }
   }

   if(dir==CRT_BULL)
   {
      if(hasAsia && c2Low<asiaLow && c2Close>asiaLow) return true;
      if(hasLondon && c2Low<londonLow && c2Close>londonLow) return true;
      if(hasPriorNY && c2Low<priorNYLow && c2Close>priorNYLow) return true;
      if(hasNY && c2Low<nyLow && c2Close>nyLow) return true;
   }
   else if(dir==CRT_BEAR)
   {
      if(hasAsia && c2High>asiaHigh && c2Close<asiaHigh) return true;
      if(hasLondon && c2High>londonHigh && c2Close<londonHigh) return true;
      if(hasPriorNY && c2High>priorNYHigh && c2Close<priorNYHigh) return true;
      if(hasNY && c2High>nyHigh && c2Close<nyHigh) return true;
   }
   return false;
}

// A wick-rejection confluence. It does not replace the CRT/CISD rules.
bool HasLiquidityRejection(ENUM_CRT_SIGNAL dir,double c2Open,
                           double c2High,double c2Low,double c2Close)
{
   double body=MathAbs(c2Close-c2Open);
   double range=c2High-c2Low;
   if(range<=0.0) return false;
   double minWick=MathMax(body*1.2,range*0.25);
   if(dir==CRT_BULL)
   {
      double lowerWick=MathMin(c2Open,c2Close)-c2Low;
      return (c2Close>c2Open && lowerWick>=minWick);
   }
   if(dir==CRT_BEAR)
   {
      double upperWick=c2High-MathMax(c2Open,c2Close);
      return (c2Close<c2Open && upperWick>=minWick);
   }
   return false;
}

// Nearest higher timeframe shows a CRT in the same direction.
// Early setups also accept a higher-timeframe CRT that is forming.
bool HTFConfluence(int stateIndex,ENUM_CRT_SIGNAL dir,bool early)
{
   int htf=FindNearestHigherState(stateIndex);

   if(htf<0)
      return false;

   if(g_states[htf].confirmedSignal==dir)
      return true;

   if(early && g_states[htf].advancedSignal==dir)
      return true;

   return false;
}

// Trend filter: the last closed candle BEFORE C2 is above (bull) or
// below (bear) its EMA. Optionally measured on the next higher timeframe.
bool CheckTrend(int stateIndex,ENUM_CRT_SIGNAL dir,datetime c2Time)
{
   string symbol=g_states[stateIndex].symbol;
   ENUM_TIMEFRAMES tf=g_states[stateIndex].timeframe;

   if(InpTrendOnHigherTF)
   {
      ENUM_TIMEFRAMES higher=FindNearestHigherTF(tf);

      if(higher!=PERIOD_CURRENT)
         tf=higher;
   }

   int period=MathMax(2,InpTrendEMAPeriod);
   int need=MathMax(20,period*4);

   int shift=iBarShift(symbol,tf,c2Time,false);

   if(shift<0)
      return false;

   double closes[];
   ArraySetAsSeries(closes,true);

   int copied=CopyClose(symbol,tf,shift+1,need,closes);

   if(copied<period+2)
      return false;

   double k=2.0/(period+1.0);
   double ema=closes[copied-1];

   for(int j=copied-2;j>=0;j--)
      ema=closes[j]*k+ema*(1.0-k);

   if(dir==CRT_BULL)
      return (closes[0]>ema);

   if(dir==CRT_BEAR)
      return (closes[0]<ema);

   return false;
}

// Partner symbol from the "SYMBOL:PARTNER,..." list.
string GetSMTPartner(string symbol)
{
   string pairs[];
   int count=StringSplit(InpSMTPairs,',',pairs);

   for(int k=0;k<count;k++)
   {
      string kv[];

      if(StringSplit(pairs[k],':',kv)!=2)
         continue;

      string a=kv[0];
      string b=kv[1];

      StringTrimLeft(a);
      StringTrimRight(a);
      StringTrimLeft(b);
      StringTrimRight(b);

      if(a==symbol)
         return b;
   }

   return "";
}

// SMT divergence: our symbol swept C1's extreme, the correlated
// partner did NOT sweep its own C1 extreme in the same candle.
bool CheckSMT(int stateIndex,ENUM_CRT_SIGNAL dir,datetime c2Time)
{
   string symbol=g_states[stateIndex].symbol;
   ENUM_TIMEFRAMES tf=g_states[stateIndex].timeframe;
   string partner=GetSMTPartner(symbol);

   if(partner=="" || partner==symbol || !SymbolSelect(partner,true))
      return false;

   int primaryShift=iBarShift(symbol,tf,c2Time,false);
   int partnerShift=iBarShift(partner,tf,c2Time,false);
   if(primaryShift<0 || partnerShift<0)
      return false;

   MqlRates primary[],paired[];
   ArraySetAsSeries(primary,true);
   ArraySetAsSeries(paired,true);
   if(CopyRates(symbol,tf,primaryShift,2,primary)<2 ||
      CopyRates(partner,tf,partnerShift,2,paired)<2)
      return false;

   // Both instruments must have the exact same C2 and C1 candle times.
   if(primary[0].time!=c2Time || paired[0].time!=c2Time ||
      primary[1].time!=paired[1].time)
      return false;

   // Primary must sweep its C1 extreme; the paired instrument must not.
   if(dir==CRT_BULL)
      return (primary[0].low<primary[1].low &&
              paired[0].low>=paired[1].low);

   if(dir==CRT_BEAR)
      return (primary[0].high>primary[1].high &&
              paired[0].high<=paired[1].high);

   return false;
}

//------------------------- LABELS / TOOLTIP ------------------------//
// Fills tags[] with the optional confluences that are present.
int BuildTags(int i,string &tags[])
{
   ArrayResize(tags,0);

   int n=0;

   if(g_states[i].cfHTF)
   {
      ArrayResize(tags,n+1);
      tags[n]="HTF";
      n++;
   }

   if(g_states[i].kzId>0)
   {
      ArrayResize(tags,n+1);
      tags[n]=(g_states[i].kzId==1 ? "LDN" : "NY");
      n++;
   }

   if(g_states[i].cfLiquidity)
   {
      ArrayResize(tags,n+1);
      tags[n]="LIQUIDITY";
      n++;
   }

   if(g_states[i].cfLiqPool)
   {
      ArrayResize(tags,n+1);
      tags[n]="POOL";
      n++;
   }


   if(g_states[i].cfLiqRejection)
   {
      ArrayResize(tags,n+1);
      tags[n]="REJECT";
      n++;
   }

   if(g_states[i].cfSMT)
   {
      ArrayResize(tags,n+1);
      tags[n]="SMT";
      n++;
   }

   if(g_states[i].cfTrend)
   {
      ArrayResize(tags,n+1);
      tags[n]="TREND";
      n++;
   }

   return n;
}

// All tags, each with a leading space (used in alerts).
string ConfluenceText(int i)
{
   string tags[];
   int n=BuildTags(i,tags);

   string text="";

   for(int k=0;k<n;k++)
      text+=" "+tags[k];

   return text;
}

// First maxTags tags, then "+N" for the rest (used on the badge).
string ConfluenceShort(int i,int maxTags)
{
   string tags[];
   int n=BuildTags(i,tags);

   if(n==0)
      return "base setup";

   string text="";

   for(int k=0;k<n && k<maxTags;k++)
   {
      if(k>0)
         text+=" ";

      text+=tags[k];
   }

   if(n>maxTags)
      text+=" +"+IntegerToString(n-maxTags);

   return text;
}


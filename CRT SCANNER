void PADrawHistoricalSwings(ENUM_TIMEFRAMES tf)
{
   if(!Show_Major_Swings && !Show_Small_Swings) return;
   int bars=MathMax(80,History_Bars_To_Show);
   MqlRates r[];
   ArraySetAsSeries(r,true);
   int copied=CopyRates(Symbol(),tf,0,bars,r);
   if(copied<MathMax(Major_Swing_Left_Bars+Major_Swing_Right_Bars+10,40)) return;

   // Rebuild only this timeframe's bounded swing-label history. This prevents
   // old labels from accumulating as new candles arrive.
   string swingPrefix=PA_PREFIX+PATFCode(tf)+"_MAJ";
   string minorPrefix=PA_PREFIX+PATFCode(tf)+"_MIN";
   for(int obj=ObjectsTotal(0,0,-1)-1;obj>=0;obj--)
   {
      string objectName=ObjectName(0,obj,0,-1);
      if(StringFind(objectName,swingPrefix)==0 || StringFind(objectName,minorPrefix)==0)
         ObjectDelete(0,objectName);
   }

   double previousMajorHigh=0.0,previousMajorLow=0.0;
   double previousMinorHigh=0.0,previousMinorLow=0.0;
   int majorDrawn=0,minorDrawn=0;
   int lastMajorHighBar=-100000,lastMajorLowBar=-100000;
   int lastMinorHighBar=-100000,lastMinorLowBar=-100000;
   double atr=MAATR(r,copied,1,Average_Range_Period);
   double tolerance=MathMax(SymbolInfoDouble(Symbol(),SYMBOL_POINT)*2.0,
                            atr*Equal_High_Low_Tolerance);
   int oldest=copied-MathMax(Major_Swing_Left_Bars,Small_Swing_Left_Bars)-1;
   int newest=MathMax(Major_Swing_Right_Bars,Small_Swing_Right_Bars)+1;

   // Iterate from older bars to newer bars so each label compares with the
   // previous confirmed pivot of the same type.
   for(int i=oldest;i>=newest;i--)
   {
      if(Show_Major_Swings && majorDrawn<Maximum_Swing_Labels_Per_Timeframe)
      {
         double pivotATR=MAATR(r,copied,i,Average_Range_Period);
         bool majorHigh=(MAIsPivotHigh(r,i,Major_Swing_Left_Bars,Major_Swing_Right_Bars) &&
                         i-lastMajorHighBar>=Minimum_Bars_Between_Swings && pivotATR>0.0 &&
                         MAPivotDeparture(r,copied,i,true)>=Minimum_Major_Swing_Size*pivotATR);
         bool majorLow=(MAIsPivotLow(r,i,Major_Swing_Left_Bars,Major_Swing_Right_Bars) &&
                        i-lastMajorLowBar>=Minimum_Bars_Between_Swings && pivotATR>0.0 &&
                        MAPivotDeparture(r,copied,i,false)>=Minimum_Major_Swing_Size*pivotATR);
         if(majorHigh)
         {
            string relation=(previousMajorHigh<=0.0 ? "SH" : MACompare(r[i].high,previousMajorHigh,tolerance,true));
            PADrawText(PAObjectKey(PATFCode(tf),"MAJH",r[i].time),r[i].time,r[i].high,
                       relation+" "+PATFCode(tf),InpBearColor,Chart_Label_Size);
            previousMajorHigh=r[i].high; majorDrawn++; lastMajorHighBar=i;
         }
         if(majorLow)
         {
            string relation=(previousMajorLow<=0.0 ? "SL" : MACompare(r[i].low,previousMajorLow,tolerance,false));
            PADrawText(PAObjectKey(PATFCode(tf),"MAJL",r[i].time),r[i].time,r[i].low,
                       relation+" "+PATFCode(tf),InpBullColor,Chart_Label_Size);
            previousMajorLow=r[i].low; majorDrawn++; lastMajorLowBar=i;
         }
      }
      if(Show_Small_Swings && minorDrawn<Maximum_Swing_Labels_Per_Timeframe)
      {
         if(MAIsPivotHigh(r,i,Small_Swing_Left_Bars,Small_Swing_Right_Bars) && i-lastMinorHighBar>=Minimum_Bars_Between_Swings)
         {
            string relation=(previousMinorHigh<=0.0 ? "mH" : "m"+MACompare(r[i].high,previousMinorHigh,tolerance,true));
            PADrawText(PAObjectKey(PATFCode(tf),"MINH",r[i].time),r[i].time,r[i].high,
                       relation+" "+PATFCode(tf),Neutral_Analysis_Color,MathMax(6,Chart_Label_Size-1));
            previousMinorHigh=r[i].high; minorDrawn++; lastMinorHighBar=i;
         }
         if(MAIsPivotLow(r,i,Small_Swing_Left_Bars,Small_Swing_Right_Bars) && i-lastMinorLowBar>=Minimum_Bars_Between_Swings)
         {
            string relation=(previousMinorLow<=0.0 ? "mL" : "m"+MACompare(r[i].low,previousMinorLow,tolerance,false));
            PADrawText(PAObjectKey(PATFCode(tf),"MINL",r[i].time),r[i].time,r[i].low,
                       relation+" "+PATFCode(tf),Neutral_Analysis_Color,MathMax(6,Chart_Label_Size-1));
            previousMinorLow=r[i].low; minorDrawn++; lastMinorLowBar=i;
         }
      }
   }
}

void PADrawFrameVisuals(const MAFrame &f)
{
   if(f.symbol!=Symbol() || f.lastClosedBar<=0) return;
   string tf=PATFCode(f.tf);
   int digits=(int)SymbolInfoInteger(f.symbol,SYMBOL_DIGITS);
   MqlRates r[];
   ArraySetAsSeries(r,true);
   int copied=CopyRates(f.symbol,f.tf,0,MathMax(80,History_Bars_To_Show),r);
   if(copied<4) return;
   datetime eventTime=r[1].time;
   datetime oldestVisible=iTime(f.symbol,f.tf,MathMin(copied-1,MathMax(20,History_Bars_To_Show-1)));
   string framePrefix=PA_PREFIX+tf+"_";
   for(int obj=ObjectsTotal(0,0,-1)-1;obj>=0;obj--)
   {
      string objectName=ObjectName(0,obj,0,-1);
      if(StringFind(objectName,framePrefix)!=0) continue;
      if((ENUM_OBJECT)ObjectGetInteger(0,objectName,OBJPROP_TYPE)==OBJ_TEXT)
      {
         datetime objectTime=(datetime)ObjectGetInteger(0,objectName,OBJPROP_TIME);
         if(oldestVisible>0 && objectTime>0 && objectTime<oldestVisible)
            ObjectDelete(0,objectName);
      }
   }
   datetime rightTime=TimeCurrent()+(datetime)(MathMax(1,PeriodSeconds(f.tf))*MathMax(5,InpFVGExtendBars));
   double pad=MathMax(SymbolInfoDouble(f.symbol,SYMBOL_POINT)*8.0,
                      MAATR(r,copied,1,Average_Range_Period)*0.12);

   if(Show_BOS_And_Market_Shifts)
   {
      if(f.bullBOS) PADrawText(PAObjectKey(tf,"BOS_UP",eventTime),eventTime,r[1].low-pad,"BOS UP | "+tf,InpBullColor,Chart_Label_Size+1);
      if(f.bearBOS) PADrawText(PAObjectKey(tf,"BOS_DN",eventTime),eventTime,r[1].high+pad,"BOS DOWN | "+tf,InpBearColor,Chart_Label_Size+1);
      if(f.bullMSS) PADrawText(PAObjectKey(tf,"MSS_UP",eventTime),eventTime,r[1].low-pad*2.0,"MSS UP | "+tf,InpBullColor,Chart_Label_Size+1);
      if(f.bearMSS) PADrawText(PAObjectKey(tf,"MSS_DN",eventTime),eventTime,r[1].high+pad*2.0,"MSS DOWN | "+tf,InpBearColor,Chart_Label_Size+1);
      PADrawHLine(PA_PREFIX+tf+"_PROTECTED_HIGH",(f.protectedHighActive ? f.protectedHigh : 0.0),"Protected High | "+tf,InpBearColor,STYLE_DASH);
      PADrawHLine(PA_PREFIX+tf+"_PROTECTED_LOW",(f.protectedLowActive ? f.protectedLow : 0.0),"Protected Low | "+tf,InpBullColor,STYLE_DASH);
      if(f.protectedHighActive) PADrawText(PAObjectKey(tf,"PROTECTED_HIGH_LABEL",eventTime),eventTime,f.protectedHigh,"PROTECTED HIGH | "+tf,InpBearColor,Chart_Label_Size);
      if(f.protectedLowActive) PADrawText(PAObjectKey(tf,"PROTECTED_LOW_LABEL",eventTime),eventTime,f.protectedLow,"PROTECTED LOW | "+tf,InpBullColor,Chart_Label_Size);
   }

   if(Show_Liquidity_And_IDM)
   {
      if(f.bullSweep) PADrawText(PAObjectKey(tf,"SSL_SWEEP",eventTime),eventTime,r[1].low-pad,"SSL SWEEP / RECLAIM | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearSweep) PADrawText(PAObjectKey(tf,"BSL_SWEEP",eventTime),eventTime,r[1].high+pad,"BSL SWEEP / RECLAIM | "+tf,InpBearColor,Chart_Label_Size);
      if(f.bullInducement || f.bearInducement)
      {
         string side=(f.bullInducement ? "BULL IDM" : "BEAR IDM");
         PADrawHLine(PA_PREFIX+tf+"_IDM",f.inducementPrice,side+" | "+tf,Neutral_Analysis_Color,STYLE_DOT);
         PADrawText(PAObjectKey(tf,"IDM",eventTime),eventTime,f.inducementPrice,side+" | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      }
      if(f.dolPrice>0.0)
      {
         PADrawHLine(PA_PREFIX+tf+"_DOL",f.dolPrice,"DOL CANDIDATE: "+f.dolName+" | "+tf,Neutral_Analysis_Color,STYLE_DASHDOT);
         PADrawText(PAObjectKey(tf,"DOL",eventTime),eventTime,f.dolPrice,"DOL | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      }
      PADrawHLine(PA_PREFIX+tf+"_MODEL_TARGET",f.modelTarget,"Projected Target | "+tf,InpBullColor,STYLE_DASH);
   }

   if(Show_Trading_Range_Levels && f.rangeValid)
   {
      PADrawHLine(PA_PREFIX+tf+"_RANGE_HIGH",f.rangeHigh,"Range High | "+tf,Neutral_Analysis_Color,STYLE_DOT);
      PADrawHLine(PA_PREFIX+tf+"_RANGE_EQ",f.eq,"EQ | "+tf,Neutral_Analysis_Color,STYLE_DASH);
      PADrawHLine(PA_PREFIX+tf+"_RANGE_LOW",f.rangeLow,"Range Low | "+tf,Neutral_Analysis_Color,STYLE_DOT);
      PADrawText(PAObjectKey(tf,"RANGE_HIGH_LABEL",eventTime),eventTime,f.rangeHigh,"RANGE HIGH | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      PADrawText(PAObjectKey(tf,"RANGE_EQ_LABEL",eventTime),eventTime,f.eq,"EQUILIBRIUM | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      PADrawText(PAObjectKey(tf,"RANGE_LOW_LABEL",eventTime),eventTime,f.rangeLow,"RANGE LOW | "+tf,Neutral_Analysis_Color,Chart_Label_Size);

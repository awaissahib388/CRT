//------------------------- FIND LTF EXTREME BAR --------------------//
datetime FindC1ExtremeTime(string symbol,
                           ENUM_TIMEFRAMES crtTF,
                           datetime c1Time,
                           double price,
                           bool isHigh)
{
   ENUM_TIMEFRAMES ltf=(ENUM_TIMEFRAMES)Period();

   if(PeriodSeconds(ltf)>=PeriodSeconds(crtTF))
      return c1Time;

   datetime c1End=c1Time+PeriodSeconds(crtTF)-1;

   MqlRates r[];
   ArraySetAsSeries(r,false);

   int copied=CopyRates(symbol,ltf,c1Time,c1End,r);

   if(copied<=0)
      return c1Time;

   int best=-1;
   double bestDiff=DBL_MAX;

   for(int i=0;i<copied;i++)
   {
      double diff=MathAbs((isHigh ? r[i].high : r[i].low)-price);

      if(diff<bestDiff)
      {
         bestDiff=diff;
         best=i;
      }
   }

   if(best<0)
      return c1Time;

   return r[best].time;
}

//------------------------- DRAW CONFIRMED CRT LEVELS ---------------//
void DrawChartCRTLevels()
{
   if(!InpDrawCRTLevels)
      return;

   string chartSymbol=Symbol();

   for(int i=0;i<g_stateCount;i++)
   {
      if(g_states[i].symbol!=chartSymbol)
         continue;

      ENUM_CRT_SIGNAL signal=g_states[i].confirmedSignal;

      if(signal==CRT_NONE)
         continue;

      if(!IsCRTVisibleOnChart(g_states[i].timeframe))
         continue;

      if(InpEnableFVGFilter &&
         !g_states[i].confirmedFVGQualified)
         continue;

      datetime c1Time=g_states[i].confirmedC1Time;
      datetime endTime=g_states[i].confirmedC3EndTime;

      if(c1Time<=0 || endTime<=c1Time)
         continue;

      ENUM_TIMEFRAMES crtTF=g_states[i].timeframe;
      string tfName=TimeframeName(crtTF);

      string base=CHART_PREFIX+"CRT_"+
                  tfName+"_"+
                  IntegerToString(i);

      double c1High=g_states[i].confirmedC1High;
      double c1Low=g_states[i].confirmedC1Low;

      if(signal==CRT_BULL)
      {
         datetime startLow=FindC1ExtremeTime(
            chartSymbol,crtTF,c1Time,c1Low,false
         );

         DrawCRTLevel(base+"_LOW",
                      startLow,endTime,c1Low,
                      InpBullCRTLineColor,
                      tfName+" CRT");
      }
      else if(signal==CRT_BEAR)
      {
         datetime startHigh=FindC1ExtremeTime(
            chartSymbol,crtTF,c1Time,c1High,true
         );

         DrawCRTLevel(base+"_HIGH",
                      startHigh,endTime,c1High,
                      InpBearCRTLineColor,
                      tfName+" CRT");
      }
      else if(signal==CRT_DOUBLE)
      {
         datetime startHigh=FindC1ExtremeTime(
            chartSymbol,crtTF,c1Time,c1High,true
         );

         datetime startLow=FindC1ExtremeTime(
            chartSymbol,crtTF,c1Time,c1Low,false
         );

         DrawCRTLevel(base+"_HIGH",
                      startHigh,endTime,c1High,
                      InpDoubleCRTLineColor,
                      tfName+" CRT");

         DrawCRTLevel(base+"_LOW",
                      startLow,endTime,c1Low,
                      InpDoubleCRTLineColor,
                      tfName+" CRT");
      }
   }
}


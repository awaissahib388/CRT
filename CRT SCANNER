// Grade from score share: A+ >= 75%, A >= 55%, otherwise B.
int GradeRank(int si)
{
   int maxScore=MaxSetupScore();

   if(maxScore<=0)
      return 0;

   double ratio=(double)g_states[si].setupScore/maxScore;

   if(ratio>=0.75)
      return 2;

   if(ratio>=0.55)
      return 1;

   return 0;
}

string GradeText(int rank)
{
   if(rank>=2)
      return "A+";

   if(rank==1)
      return "A";

   return "B";
}

bool PassFilter(int si)
{
   switch(g_filter)
   {
      case 1: return (g_states[si].setupDir==CRT_BULL);
      case 2: return (g_states[si].setupDir==CRT_BEAR);
      case 3: return g_states[si].setupEarly;
      case 4: return (GradeRank(si)>=1);
   }

   return true;
}

string FormatAge(long seconds)
{
   if(seconds<60)
      return "<1m";

   long minutes=seconds/60;

   if(minutes<60)
      return IntegerToString((int)minutes)+"m";

   long hours=minutes/60;
   long restMinutes=minutes%60;

   if(hours<24)
      return IntegerToString((int)hours)+"h "+
             IntegerToString((int)restMinutes)+"m";

   long days=hours/24;
   long restHours=hours%24;

   return IntegerToString((int)days)+"d "+
          IntegerToString((int)restHours)+"h";
}


                 MARangeLocation(f.rangePos)+" | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
   }

   if(Show_Price_Action_Patterns)
   {
      if(f.bullishEngulf) PADrawText(PAObjectKey(tf,"BULL_ENGULF",eventTime),eventTime,r[1].low-pad,"BULL ENGULF | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearishEngulf) PADrawText(PAObjectKey(tf,"BEAR_ENGULF",eventTime),eventTime,r[1].high+pad,"BEAR ENGULF | "+tf,InpBearColor,Chart_Label_Size);
      if(f.failedBreakUp) PADrawText(PAObjectKey(tf,"FAILED_HIGH",eventTime),eventTime,r[1].high+pad*2.0,"FAILED HIGH | "+tf,InpBearColor,Chart_Label_Size);
      if(f.failedBreakDown) PADrawText(PAObjectKey(tf,"FAILED_LOW",eventTime),eventTime,r[1].low-pad*2.0,"FAILED LOW | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bullFVG || f.bearFVG)
      {
         string side=(f.bullFVG ? "BULL FVG TOUCH" : "BEAR FVG TOUCH");
         color fvgColor=(f.bullFVG ? InpBullColor : InpBearColor);
         PADrawText(PAObjectKey(tf,"FVG_TOUCH",eventTime),eventTime,r[1].close,side+" | "+tf,
                    fvgColor,Chart_Label_Size);
         bool zoneDrawn=false;
         for(int z=2;z<MathMin(copied-2,Bars_To_Find_Recent_Patterns+2);z++)
         {
            if(f.bullFVG && r[z+2].high<r[z].low && r[1].low<=r[z].low && r[1].high>=r[z+2].high)
            {
               PADrawZone(PA_PREFIX+tf+"_FVG_TOUCH_ZONE",r[z+2].time,rightTime,r[z+2].high,r[z].low,"BULL FVG TOUCH | "+tf,InpBullColor);
               PADrawText(PAObjectKey(tf,"FVG_ZONE_LABEL",eventTime),eventTime,(r[z+2].high+r[z].low)*0.5,"BULL FVG ZONE | "+tf,InpBullColor,Chart_Label_Size);
               zoneDrawn=true; break;
            }
            if(f.bearFVG && r[z+2].low>r[z].high && r[1].high>=r[z].high && r[1].low<=r[z+2].low)
            {
               PADrawZone(PA_PREFIX+tf+"_FVG_TOUCH_ZONE",r[z+2].time,rightTime,r[z].high,r[z+2].low,"BEAR FVG TOUCH | "+tf,InpBearColor);
               PADrawText(PAObjectKey(tf,"FVG_ZONE_LABEL",eventTime),eventTime,(r[z].high+r[z+2].low)*0.5,"BEAR FVG ZONE | "+tf,InpBearColor,Chart_Label_Size);
               zoneDrawn=true; break;
            }
         }
         if(!zoneDrawn) ObjectDelete(0,PA_PREFIX+tf+"_FVG_TOUCH_ZONE");
      }
      else ObjectDelete(0,PA_PREFIX+tf+"_FVG_TOUCH_ZONE");
      if(f.bullVI || f.bearVI)
      {
         color c=(f.bullVI ? InpBullColor : InpBearColor);
         PADrawZone(PA_PREFIX+tf+"_VI_ZONE",iTime(f.symbol,f.tf,2),rightTime,f.viLow,f.viHigh,
                    (f.bullVI ? "BULL VI | "+tf : "BEAR VI | "+tf),c);
         PADrawText(PAObjectKey(tf,"VI",eventTime),eventTime,(f.bullVI ? f.viLow : f.viHigh),
                    (f.bullVI ? "BULL VI" : "BEAR VI")+" | "+tf,c,Chart_Label_Size);
      }
      else ObjectDelete(0,PA_PREFIX+tf+"_VI_ZONE");
      if(f.bullIFVG) PADrawText(PAObjectKey(tf,"BULL_IFVG",eventTime),eventTime,r[1].low-pad,"BULL IFVG | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearIFVG) PADrawText(PAObjectKey(tf,"BEAR_IFVG",eventTime),eventTime,r[1].high+pad,"BEAR IFVG | "+tf,InpBearColor,Chart_Label_Size);
      if(f.bullRetest) PADrawText(PAObjectKey(tf,"BULL_RETEST",eventTime),eventTime,r[1].low-pad*2.0,"BULL RETEST | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearRetest) PADrawText(PAObjectKey(tf,"BEAR_RETEST",eventTime),eventTime,r[1].high+pad*2.0,"BEAR RETEST | "+tf,InpBearColor,Chart_Label_Size);
      if(f.bullEngulfFlip) PADrawText(PAObjectKey(tf,"BULL_ENGULF_FLIP",eventTime),eventTime,r[1].low-pad*3.0,"BULL ENGULF FLIP | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearEngulfFlip) PADrawText(PAObjectKey(tf,"BEAR_ENGULF_FLIP",eventTime),eventTime,r[1].high+pad*3.0,"BEAR ENGULF FLIP | "+tf,InpBearColor,Chart_Label_Size);
      if(f.rangeAcceptedUp) PADrawText(PAObjectKey(tf,"RANGE_ACCEPT_UP",eventTime),eventTime,r[1].low-pad*4.0,"RANGE ACCEPTED UP | "+tf,InpBullColor,Chart_Label_Size);
      else if(f.expansionUp) PADrawText(PAObjectKey(tf,"RANGE_EXPAND_UP",eventTime),eventTime,r[1].low-pad*4.0,"RANGE BREAK CANDIDATE UP | "+tf,InpBullColor,Chart_Label_Size);
      if(f.rangeAcceptedDown) PADrawText(PAObjectKey(tf,"RANGE_ACCEPT_DN",eventTime),eventTime,r[1].high+pad*4.0,"RANGE ACCEPTED DOWN | "+tf,InpBearColor,Chart_Label_Size);
      else if(f.expansionDown) PADrawText(PAObjectKey(tf,"RANGE_EXPAND_DN",eventTime),eventTime,r[1].high+pad*4.0,"RANGE BREAK CANDIDATE DOWN | "+tf,InpBearColor,Chart_Label_Size);
      if(f.kissingCandle) PADrawText(PAObjectKey(tf,"KISSING",eventTime),eventTime,f.kissingLevel,"KISSING / SNR CANDIDATE | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      if(f.bullQML) PADrawText(PAObjectKey(tf,"BULL_QML",eventTime),eventTime,f.bullQMLLevel,"BULL QML | "+tf,InpBullColor,Chart_Label_Size);
      if(f.bearQML) PADrawText(PAObjectKey(tf,"BEAR_QML",eventTime),eventTime,f.bearQMLLevel,"BEAR QML | "+tf,InpBearColor,Chart_Label_Size);
      if(f.liquiditySNR) PADrawText(PAObjectKey(tf,"LS_SNR",eventTime),eventTime,r[1].close,"LIQUIDITY SWEEP + SNR | "+tf,Neutral_Analysis_Color,Chart_Label_Size);
      if(f.pocFound) PADrawHLine(PA_PREFIX+tf+"_PCZ",f.pocLevel,"PCZ / REPEATED REJECTION | "+tf,Neutral_Analysis_Color,STYLE_DASHDOT);
      else ObjectDelete(0,PA_PREFIX+tf+"_PCZ");
      if(f.supportTrendlineValid) PADrawHLine(PA_PREFIX+tf+"_SUPPORT_TL",f.supportTrendlineNow,"SUPPORT TRENDLINE LEVEL | "+tf,InpBullColor,STYLE_DASHDOT);
      else ObjectDelete(0,PA_PREFIX+tf+"_SUPPORT_TL");
      if(f.resistanceTrendlineValid) PADrawHLine(PA_PREFIX+tf+"_RESIST_TL",f.resistanceTrendlineNow,"RESISTANCE TRENDLINE LEVEL | "+tf,InpBearColor,STYLE_DASHDOT);
      else ObjectDelete(0,PA_PREFIX+tf+"_RESIST_TL");
   }

   if(Show_Supply_And_Demand_Zones)
   {
      if(f.demandActive)
      {
         datetime left=iTime(f.symbol,f.tf,MathMin(copied-1,Bars_To_Find_Recent_Patterns+2));
         for(int j=2;j<MathMin(copied,Bars_To_Find_Recent_Patterns+4);j++)
            if(MathAbs(r[j].low-f.demandLow)<=SymbolInfoDouble(f.symbol,SYMBOL_POINT)*2.0 &&
               MathAbs(r[j].open-f.demandHigh)<=SymbolInfoDouble(f.symbol,SYMBOL_POINT)*2.0)
            {left=r[j].time;break;}
         PADrawZone(PA_PREFIX+tf+"_DEMAND",left,rightTime,f.demandLow,f.demandHigh,
                    "DEMAND | "+tf+" | "+MAFreshnessText(f.demandFreshness),InpBullColor);
         PADrawText(PAObjectKey(tf,"DEMAND_LABEL",eventTime),eventTime,(f.demandLow+f.demandHigh)*0.5,
                    "DEMAND | "+tf+" | "+MAFreshnessText(f.demandFreshness),InpBullColor,Chart_Label_Size);
         if(f.demandFreshness==3)
            PADrawText(PAObjectKey(tf,"DEMAND_BROKEN",eventTime),eventTime,f.demandLow,"DEMAND BROKEN | "+tf,InpBearColor,Chart_Label_Size);
         else if(f.mitigationDemand)
            PADrawText(PAObjectKey(tf,"DEMAND_MITIGATION",eventTime),eventTime,f.demandLow,"DEMAND MITIGATION | "+tf,InpBullColor,Chart_Label_Size);
      }
      else ObjectDelete(0,PA_PREFIX+tf+"_DEMAND");
      if(f.supplyActive)
      {
         datetime left=iTime(f.symbol,f.tf,MathMin(copied-1,Bars_To_Find_Recent_Patterns+2));
         for(int j=2;j<MathMin(copied,Bars_To_Find_Recent_Patterns+4);j++)
            if(MathAbs(r[j].open-f.supplyLow)<=SymbolInfoDouble(f.symbol,SYMBOL_POINT)*2.0 &&
               MathAbs(r[j].high-f.supplyHigh)<=SymbolInfoDouble(f.symbol,SYMBOL_POINT)*2.0)
            {left=r[j].time;break;}
         PADrawZone(PA_PREFIX+tf+"_SUPPLY",left,rightTime,f.supplyLow,f.supplyHigh,
                    "SUPPLY | "+tf+" | "+MAFreshnessText(f.supplyFreshness),InpBearColor);
         PADrawText(PAObjectKey(tf,"SUPPLY_LABEL",eventTime),eventTime,(f.supplyLow+f.supplyHigh)*0.5,
                    "SUPPLY | "+tf+" | "+MAFreshnessText(f.supplyFreshness),InpBearColor,Chart_Label_Size);
         if(f.supplyFreshness==3)
            PADrawText(PAObjectKey(tf,"SUPPLY_BROKEN",eventTime),eventTime,f.supplyHigh,"SUPPLY BROKEN | "+tf,InpBullColor,Chart_Label_Size);
         else if(f.mitigationSupply)
            PADrawText(PAObjectKey(tf,"SUPPLY_MITIGATION",eventTime),eventTime,f.supplyHigh,"SUPPLY MITIGATION | "+tf,InpBearColor,Chart_Label_Size);
      }
      else ObjectDelete(0,PA_PREFIX+tf+"_SUPPLY");
      if(f.demandFlip) PADrawText(PAObjectKey(tf,"DEMAND_FLIP",eventTime),eventTime,r[1].close,"DEMAND FLIP | "+tf,InpBullColor,Chart_Label_Size);
      if(f.supplyFlip) PADrawText(PAObjectKey(tf,"SUPPLY_FLIP",eventTime),eventTime,r[1].close,"SUPPLY FLIP | "+tf,InpBearColor,Chart_Label_Size);
   }
}

void PADrawStatusPanel()

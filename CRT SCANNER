// Most recent CRT in the history list for this symbol/timeframe.
int FindLatestHistory(string symbol,ENUM_TIMEFRAMES tf)
{
   int best=-1;
   datetime bestTime=0;

   for(int k=0;k<g_crtHistoryCount;k++)
   {
      if(g_crtHistory[k].symbol!=symbol ||
         g_crtHistory[k].timeframe!=tf)
         continue;

      if(g_crtHistory[k].c2Time>bestTime)
      {
         bestTime=g_crtHistory[k].c2Time;
         best=k;
      }
   }

   return best;
}

// A setup expires InpSetupMaxAgeCandles CRT candles after C2.
bool IsCandidateFresh(int stateIndex,datetime c2Time)
{
   int shift=iBarShift(g_states[stateIndex].symbol,
                       g_states[stateIndex].timeframe,
                       c2Time,
                       false);

   if(shift<0)
      return false;

   int maxAge=InpSetupMaxAgeCandles;

   if(maxAge<1)
      maxAge=1;

   return (shift<=maxAge);
}

//------------------------- JOURNAL / STATS -------------------------//
// Every setup that ends at its stop loss (loss) or its target (win)
// is written to a CSV file and counted per confluence, so you can
// see which confluences really improve the win rate on YOUR data.
#define JN_FLAGS 11

int g_jnWins=0;
int g_jnLoss=0;
double g_jnNetR=0.0;
int g_jnLast[5];
int g_jnLastCount=0;
int g_jnFlagWin[JN_FLAGS];
int g_jnFlagLoss[JN_FLAGS];
int g_jnNoFlagWin[JN_FLAGS];
int g_jnNoFlagLoss[JN_FLAGS];

string g_jnNames[JN_FLAGS]={"HTF","KILLZONE","EXTERNAL LIQUIDITY","DOJI C1",
                            "TREND","DISPLACEMENT","SMT","EARLY",
                            "LIQUIDITY POOL","SESSION LIQUIDITY","SWEEP REJECTION"};

void JournalReset()
{
   g_jnWins=0;
   g_jnLoss=0;
   g_jnNetR=0.0;
   g_jnLastCount=0;

   for(int q=0;q<5;q++)
      g_jnLast[q]=0;

   for(int k=0;k<JN_FLAGS;k++)
   {
      g_jnFlagWin[k]=0;
      g_jnFlagLoss[k]=0;
      g_jnNoFlagWin[k]=0;
      g_jnNoFlagLoss[k]=0;
   }
}

void JournalTally(bool win,const int &flags[],double rr)
{
   if(win)
      g_jnWins++;
   else
      g_jnLoss++;

   // Net result in R: a win pays the planned RR, a loss costs 1R.
   g_jnNetR+=(win ? MathMax(0.0,rr) : -1.0);

   // Keep the last five results (oldest first).
   if(g_jnLastCount<5)
   {
      g_jnLast[g_jnLastCount]=(win ? 1 : 0);
      g_jnLastCount++;
   }
   else
   {
      for(int q=0;q<4;q++)
         g_jnLast[q]=g_jnLast[q+1];

      g_jnLast[4]=(win ? 1 : 0);
   }

   for(int k=0;k<JN_FLAGS;k++)
   {
      if(flags[k]==1)
      {
         if(win) g_jnFlagWin[k]++; else g_jnFlagLoss[k]++;
      }
      else
      {
         if(win) g_jnNoFlagWin[k]++; else g_jnNoFlagLoss[k]++;
      }
   }
}

string WinPct(int wins,int losses)
{
   int total=wins+losses;

   if(total<=0)
      return "n/a";

   return DoubleToString((100.0*wins)/total,0)+"%";
}

string StatsLine()
{
   if(g_jnWins+g_jnLoss<=0)
      return "NO CLOSED SETUPS YET";

   return "WIN RATE "+WinPct(g_jnWins,g_jnLoss)+"    "+
          IntegerToString(g_jnWins)+"W "+
          IntegerToString(g_jnLoss)+"L    NET "+
          (g_jnNetR>=0.0 ? "+" : "")+
          DoubleToString(g_jnNetR,1)+"R";
}

void JournalPrint()
{
   Print("GloryAlgo STATS | closed setups: ",g_jnWins+g_jnLoss,
         " | win rate ",WinPct(g_jnWins,g_jnLoss),
         " (",g_jnWins,"W ",g_jnLoss,"L)");

   for(int k=0;k<JN_FLAGS;k++)
   {
      Print("   ",g_jnNames[k],
            " | with: ",g_jnFlagWin[k],"W ",g_jnFlagLoss[k],"L (",
            WinPct(g_jnFlagWin[k],g_jnFlagLoss[k]),")",
            " | without: ",g_jnNoFlagWin[k],"W ",g_jnNoFlagLoss[k],"L (",
            WinPct(g_jnNoFlagWin[k],g_jnNoFlagLoss[k]),")");
   }
}

void JournalLoad()
{
   JournalReset();

   if(!InpJournal)
      return;

   int handle=FileOpen(InpJournalFile,
                       FILE_READ|FILE_CSV|FILE_ANSI|
                       FILE_SHARE_READ|FILE_SHARE_WRITE,
                       ',');

   if(handle==INVALID_HANDLE)
      return;

   while(!FileIsEnding(handle))
   {
      string cell[20];

      for(int c=0;c<20;c++)
         cell[c]=FileReadString(handle);

      if(cell[0]=="" || cell[0]=="time")
         continue;

      int flags[JN_FLAGS];

      flags[0]=(int)StringToInteger(cell[7]);    // htf
      flags[1]=(int)StringToInteger(cell[8]);    // killzone
      flags[2]=(int)StringToInteger(cell[9]);    // liquidity
      flags[3]=(int)StringToInteger(cell[10]);   // doji
      flags[4]=(int)StringToInteger(cell[11]);   // trend
      flags[5]=(int)StringToInteger(cell[12]);   // displacement
      flags[6]=(int)StringToInteger(cell[13]);   // smt
      flags[7]=(int)StringToInteger(cell[4]);    // early
      flags[8]=(int)StringToInteger(cell[14]);   // liquidity pool
      flags[9]=(int)StringToInteger(cell[15]);   // session liquidity
      flags[10]=(int)StringToInteger(cell[16]);  // sweep rejection

      JournalTally(cell[17]=="W",flags,StringToDouble(cell[6]));
   }

   FileClose(handle);
}

// Called with the OLD setup data still in the state (before it is cleared).
void JournalRecord(int i,int reason)
{
   if(reason!=1 && reason!=2)
      return;

   bool win=(reason==2);

   int flags[JN_FLAGS];

   flags[0]=(g_states[i].cfHTF ? 1 : 0);
   flags[1]=(g_states[i].kzId>0 ? 1 : 0);
   flags[2]=(g_states[i].cfLiquidity ? 1 : 0);
   flags[3]=0;
   flags[4]=(g_states[i].cfTrend ? 1 : 0);
   flags[5]=0;
   flags[6]=(g_states[i].cfSMT ? 1 : 0);
   flags[7]=(g_states[i].setupEarly ? 1 : 0);
   flags[8]=(g_states[i].cfLiqPool ? 1 : 0);
   flags[9]=0; // liquidity is logged once in flags[2]
   flags[10]=(g_states[i].cfLiqRejection ? 1 : 0);

   JournalTally(win,flags,g_states[i].setupRR);

   Print("GloryAlgo RESULT | ",g_states[i].symbol," ",
         TimeframeName(g_states[i].timeframe)," ",
         (g_states[i].setupDir==CRT_BULL ? "BULLISH" : "BEARISH"),
         " | ",(win ? "WIN" : "LOSS"),
         " | win rate ",WinPct(g_jnWins,g_jnLoss),
         " (",g_jnWins,"W ",g_jnLoss,"L)");

   if(!InpJournal)
      return;

   int handle=FileOpen(InpJournalFile,
                       FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI|
                       FILE_SHARE_READ|FILE_SHARE_WRITE,
                       ',');

   if(handle==INVALID_HANDLE)
   {
      Print("GloryAlgo: could not open journal file. Error: ",
            GetLastError());
      return;
   }

   if(FileSize(handle)==0)
   {
      FileWrite(handle,"time","symbol","tf","dir","early","score","rr",
                "htf","kz","external_liq","doji","trend","disp","smt",
                "liq_pool","session_liq","sweep_rejection","result","reason","c2_time");
   }

   FileSeek(handle,0,SEEK_END);

   FileWrite(handle,
             TimeToString(TimeCurrent(),
                          TIME_DATE|TIME_MINUTES|TIME_SECONDS),
             g_states[i].symbol,
             TimeframeName(g_states[i].timeframe),
             (g_states[i].setupDir==CRT_BULL ? "BULL" : "BEAR"),
             flags[7],
             g_states[i].setupScore,
             DoubleToString(g_states[i].setupRR,2),
             flags[0],flags[1],flags[2],flags[3],
             flags[4],flags[5],flags[6],
             flags[8],flags[9],flags[10],
             (win ? "W" : "L"),
             (win ? "TARGET" : "STOP"),
             TimeToString(g_states[i].setupC2Time,TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   FileClose(handle);
}

//------------------------- ALERTS ----------------------------------//
void SendSetupAlert(int stateIndex)
{
   string direction=
      (g_states[stateIndex].setupDir==CRT_BULL ?
       "BULLISH" : "BEARISH");

   string message="GloryAlgo SETUP | "+
                  g_states[stateIndex].symbol+" | "+
                  TimeframeName(g_states[stateIndex].timeframe)+" | "+
                  direction+" | "+
                  IntegerToString(g_states[stateIndex].setupScore)+"/"+
                  IntegerToString(MaxSetupScore())+" | "+
                  RRText(stateIndex)+
                  ConfluenceText(stateIndex);

   if(g_states[stateIndex].setupEarly)
      message+=" | EARLY";

   message+=" | C2="+TimeToString(g_states[stateIndex].setupC2Time,
                                    TIME_DATE|TIME_MINUTES);
   Alert(message);

   if(InpEnablePushNotifications)
      SendNotification(message);
}

void SendCloseAlert(int stateIndex,ENUM_CRT_SIGNAL dir,int reason)
{
   string why="CRT INVALIDATED";

   if(reason==1)
      why="STOP LOSS HIT";
   else if(reason==2)
      why="TARGET HIT";

   string message="GloryAlgo SETUP CLOSED | "+
                  g_states[stateIndex].symbol+" | "+
                  TimeframeName(g_states[stateIndex].timeframe)+" | "+
                  (dir==CRT_BULL ? "BULLISH" : "BEARISH")+" | "+
                  why+" | C2="+
                  TimeToString(g_states[stateIndex].setupC2Time,
                               TIME_DATE|TIME_MINUTES);

   Alert(message);

   if(InpEnablePushNotifications)
      SendNotification(message);
}

//------------------------- EVALUATE ONE CANDIDATE ------------------//
void EvaluateCandidate(int i,const CRTCandidate &c,SetupEval &ev)
{
   ev.valid=false;
   ev.closeReason=0;
   ev.score=0;
   ev.cfHTF=false;
   ev.cfLiquidity=false;
   ev.cfLiqPool=false;
   ev.cfLiqSession=false;
   ev.cfLiqRejection=false;
   ev.kzId=0;
   ev.cfTrend=false;
   ev.cfSMT=false;
   ev.entry=0.0;
   ev.sl=0.0;
   ev.tp2=0.0;
   ev.rr=-1.0;
   ev.extremeTime=0;
   ev.cisdTime=0;
   ev.cisdPrice=0.0;
   ev.formTime=0;

   ENUM_CRT_SIGNAL dir=c.dir;

   if(dir!=CRT_BULL && dir!=CRT_BEAR)
      return;

   string symbol=g_states[i].symbol;
   ENUM_TIMEFRAMES tf=g_states[i].timeframe;

   // Do not recreate a CRT setup whose C2 candidate already reached a
   // terminal state (SL, TP, invalidation/expiry) during this EA run.
   if(IsSetupKeyClosed(symbol,tf,dir,c.c2Time))
      return;

   double tp2=(dir==CRT_BULL ? c.c1High : c.c1Low);

   CISDResult cr;

   if(!ComputeCISD(symbol,tf,dir,c.c2Time,tp2,cr))
      return;

   if(!cr.extremeFound)
      return;

   // Price already took out the stop loss / reached the target.
   if(cr.slBreached)
   {
      ev.closeReason=1;
      return;
   }

   if(cr.tpHit && InpDismissOnTP)
   {
      ev.closeReason=2;
      return;
   }

   // CISD is mandatory for EVERY setup. The input toggle only controls
   // CISD chart-state/level display; it cannot bypass setup confirmation.
   if(!cr.refFound || !cr.confirmed)
      return;

   // Planned trade: entry at the CISD confirmation close.
   double bid=SymbolInfoDouble(symbol,SYMBOL_BID);
   double ask=SymbolInfoDouble(symbol,SYMBOL_ASK);

   double entry=0.0;

   if(cr.confirmed && cr.confClose>0.0)
      entry=cr.confClose;
   else
      entry=(dir==CRT_BULL ? ask : bid);

   double sl=cr.extremePrice;
   double risk=(dir==CRT_BULL ? entry-sl : sl-entry);
   double reward=(dir==CRT_BULL ? tp2-entry : entry-tp2);

   if(entry<=0.0 || risk<=0.0 || reward<=0.0)
      return;

   double rr=reward/risk;

   // Hard filter: not enough reward for the risk.
   if(InpMinRR>0.0 && rr<InpMinRR)
      return;

   // Hard filter: against the EMA trend.
   bool trendOK=false;

   if(InpUseTrendEMA)
      trendOK=CheckTrend(i,dir,c.c2Time); // informational bonus only; never blocks a setup

   // HTF FVG touched by C2 (always required for early setups).
   if(c.early || InpSetupRequireFVG)
   {
      bool fvg=false;

      if(!c.early && c.c2Time==g_states[i].confirmedC2Time)
      {
         fvg=g_states[i].confirmedFVGPresent;
      }
      else if(!c.early && c.c2Time==g_states[i].fvgCacheC2)
      {
         fvg=g_states[i].fvgCacheVal;
      }
      else
      {
         MqlRates c2Bar;
         ZeroMemory(c2Bar);

         c2Bar.time=c.c2Time;
         c2Bar.high=c.c2High;
         c2Bar.low=c.c2Low;

         fvg=CheckCRTFVG(i,dir,c2Bar);

         if(!c.early)
         {
            g_states[i].fvgCacheC2=c.c2Time;
            g_states[i].fvgCacheVal=fvg;
         }
      }

      if(!fvg)
         return;
   }

   // ---------------- score ----------------
   int score=0;

   if(InpUseHTFCRTConfluence && HTFConfluence(i,dir,c.early))
   {
      ev.cfHTF=true;
      score++;
   }

   if(InpUseKillzones &&
      PeriodSeconds(tf)<PeriodSeconds(PERIOD_D1))
   {
      datetime refTime=(cr.confTime>0 ? cr.confTime : TimeCurrent());

      int kz=KillzoneId(refTime);

      if(kz>0)
      {
         ev.kzId=kz;
         score++;
      }
   }


   if(InpUseLiquidityPools &&
      CheckLiquidityPoolSweep(i,dir,c.c2Time,c.c2High,c.c2Low,c.c2Close))
   {
      ev.cfLiqPool=true;
      score++;
   }

   // Session and external (PDH/PDL/PWH/PWL) sweeps share ONE score point.
   bool externalSweep=false;
   bool sessionSweep=false;
   if(InpUseLiquiditySweep)
      externalSweep=CheckLiquiditySweep(i,dir,c.c2Time,c.c2High,c.c2Low);
   if(InpUseSessionLiquidity)
      sessionSweep=CheckSessionLiquiditySweep(i,dir,c.c2Time,c.c2High,c.c2Low,c.c2Close);
   if(externalSweep || sessionSweep)
   {
      ev.cfLiquidity=true;
      ev.cfLiqSession=sessionSweep;
      score++;
   }


   if(InpUseSweepRejection &&
      HasLiquidityRejection(dir,c.c2Open,c.c2High,c.c2Low,c.c2Close))
      ev.cfLiqRejection=true; // bonus tag only

   if(InpUseTrendEMA && trendOK)
      ev.cfTrend=true; // EMA 24 is informational only; no score point

   if(InpUseSMT && CheckSMT(i,dir,c.c2Time))
   {
      ev.cfSMT=true;
      score++;
   }

   int minScore=(c.early ? InpEarlyMinScore : InpMinSetupScore);

   if(score<minScore)
      return;

   ev.valid=true;
   ev.score=score;
   ev.entry=entry;
   ev.sl=sl;
   ev.tp2=tp2;
   ev.rr=rr;
   ev.extremeTime=cr.extremeTime;
   ev.cisdTime=cr.refTime;
   ev.cisdPrice=cr.refPrice;

   int ltfSeconds=PeriodSeconds(GetCISDTimeframe(tf));

   ev.formTime=((cr.confirmed && cr.confTime>0) ?
                cr.confTime+ltfSeconds : c.c2Time);
}

//------------------------- UPDATE SETUP ----------------------------//
void UpdateSetup(int i)
{
   string symbol=g_states[i].symbol;
   ENUM_TIMEFRAMES tf=g_states[i].timeframe;

   // What the state held before this scan.
   bool wasActive=g_states[i].setupActive;
   bool oldEarly=g_states[i].setupEarly;
   ENUM_CRT_SIGNAL oldDir=g_states[i].setupDir;
   datetime oldKey=g_states[i].setupC2Time;

   SetupEval best;
   bool found=false;
   bool foundEarly=false;
   ENUM_CRT_SIGNAL foundDir=CRT_NONE;
   datetime foundKey=0;

   int closeReason=0;
   datetime closeKey=0;

   // 1) Latest completed CRT (valid until SL / TP / expiry).
   int h=FindLatestHistory(symbol,tf);

   if(h>=0)
   {
      CRTHistory item=g_crtHistory[h];

      if((item.signal==CRT_BULL || item.signal==CRT_BEAR) &&
         IsCandidateFresh(i,item.c2Time))
      {
         CRTCandidate cand;

         cand.dir=item.signal;
         cand.c2Time=item.c2Time;
         cand.c1Open=item.c1Open;
         cand.c1High=item.c1High;
         cand.c1Low=item.c1Low;
         cand.c1Close=item.c1Close;
         cand.c2Open=item.c2Open;
         cand.c2High=item.c2High;
         cand.c2Low=item.c2Low;
         cand.c2Close=item.c2Close;
         cand.early=false;

         SetupEval ev;

         EvaluateCandidate(i,cand,ev);

         if(ev.valid)
         {
            best=ev;
            found=true;
            foundDir=item.signal;
            foundKey=item.c2Time;
         }
         else if(ev.closeReason>0)
         {
            closeReason=ev.closeReason;
            closeKey=item.c2Time;
         }
      }
   }

   // 2) EARLY: the forming candle is C2, C1 is already complete.
   ENUM_CRT_SIGNAL adv=g_states[i].advancedSignal;
   datetime formingTime=g_states[i].currentBarTime;

   if(!found && InpEarlySetups && formingTime>0 &&
      (adv==CRT_BULL || adv==CRT_BEAR))
   {
      CRTCandidate cand;

      cand.dir=adv;
      cand.c2Time=formingTime;
      cand.c1Open=g_states[i].advC1Open;
      cand.c1High=g_states[i].advC1High;
      cand.c1Low=g_states[i].advC1Low;
      cand.c1Close=g_states[i].advC1Close;
      cand.c2Open=g_states[i].advC2Open;
      cand.c2High=g_states[i].advC2High;
      cand.c2Low=g_states[i].advC2Low;
      cand.c2Close=g_states[i].advC2Close;
      cand.early=true;

      SetupEval ev;

      EvaluateCandidate(i,cand,ev);

      if(ev.valid)
      {
         best=ev;
         found=true;
         foundEarly=true;
         foundDir=adv;
         foundKey=formingTime;
      }
      else if(ev.closeReason>0 && closeReason==0)
      {
         closeReason=ev.closeReason;
         closeKey=formingTime;
      }
   }

   // 3) A previously active setup has just ended.
   if(wasActive && (!found || foundKey!=oldKey))
   {
      int reason=0;

      if(closeReason>0 && closeKey==oldKey)
      {
         reason=closeReason;
      }
      else if(!found && oldEarly)
      {
         // Early setup: C2 made a new extreme (old SL taken out),
         // or the forming candle no longer qualifies as a CRT.
         reason=((adv==oldDir && oldKey==formingTime) ? 1 : 3);
      }

      // Tombstone the old candidate regardless of whether the reason was
      // SL, TP, invalidation or expiry. This prevents duplicate outcomes.
      RememberClosedSetupKey(symbol,tf,oldDir,oldKey);
      Print("GloryAlgo SETUP FINALIZED | ",symbol," | ",
            TimeframeName(tf)," | ",
            (oldDir==CRT_BULL ? "BULLISH" : "BEARISH"),
            " | C2=",TimeToString(oldKey,TIME_DATE|TIME_MINUTES),
            " | reason=",reason);

      if(reason==1 || reason==2)
         JournalRecord(i,reason);

      if(reason>0 && g_firstScanDone && InpEnableSetupAlerts)
         SendCloseAlert(i,oldDir,reason);
   }

   // 4) Store the result.
   if(!found)
   {
      g_states[i].setupActive=false;
      g_states[i].setupScore=0;
      g_states[i].setupEarly=false;
      g_states[i].setupDir=CRT_NONE;
      g_states[i].setupC2Time=0;
      g_states[i].setupExtTime=0;
      g_states[i].setupCisdTime=0;
      g_states[i].setupCisdPrice=0.0;
      g_states[i].cfHTF=false;
      g_states[i].cfLiquidity=false;
      g_states[i].cfLiqPool=false;
      g_states[i].cfLiqSession=false;
      g_states[i].cfLiqRejection=false;
      g_states[i].kzId=0;
      g_states[i].cfTrend=false;
      g_states[i].cfSMT=false;
      g_states[i].setupEntry=0.0;
      g_states[i].setupSL=0.0;
      g_states[i].setupFormTime=0;
      g_states[i].setupTP=0.0;
      g_states[i].setupRR=-1.0;
      return;
   }

   g_states[i].setupActive=true;
   g_states[i].setupScore=best.score;
   g_states[i].setupEarly=foundEarly;
   g_states[i].setupDir=foundDir;
   g_states[i].setupC2Time=foundKey;
   g_states[i].setupExtTime=best.extremeTime;
   g_states[i].setupCisdTime=best.cisdTime;
   g_states[i].setupCisdPrice=best.cisdPrice;
   g_states[i].cfHTF=best.cfHTF;
   g_states[i].cfLiquidity=best.cfLiquidity;
   g_states[i].cfLiqPool=best.cfLiqPool;
   g_states[i].cfLiqSession=best.cfLiqSession;
   g_states[i].cfLiqRejection=best.cfLiqRejection;
   g_states[i].kzId=best.kzId;
   g_states[i].cfTrend=best.cfTrend;
   g_states[i].cfSMT=best.cfSMT;
   g_states[i].setupEntry=best.entry;
   g_states[i].setupSL=best.sl;
   g_states[i].setupFormTime=best.formTime;
   g_states[i].setupTP=best.tp2;
   g_states[i].setupRR=best.rr;

   // One alert per setup. An early setup that is later confirmed
   // (same C2 and same extreme) does not alert twice.
   if(g_states[i].setupAlertC2!=foundKey ||
      g_states[i].setupAlertExt!=best.extremeTime)
   {
      g_states[i].setupAlertC2=foundKey;
      g_states[i].setupAlertExt=best.extremeTime;

      if(g_firstScanDone && InpEnableSetupAlerts)
         SendSetupAlert(i);
   }
}

//------------------------- SCAN ONE STATE --------------------------//
void ScanState(int index)
{
   string symbol=g_states[index].symbol;
   ENUM_TIMEFRAMES tf=g_states[index].timeframe;

   MqlRates rates[];
   ArraySetAsSeries(rates,true);

   if(CopyRates(symbol,tf,0,3,rates)<3)
      return;

   datetime currentTime=rates[0].time;

   ENUM_CRT_SIGNAL advanced=
      ClassifyCRT(rates[1],rates[0]);

   g_states[index].advancedSignal=advanced;
   g_states[index].advancedFVGQualified=false;

   // Snapshot of the still-forming C2 against the completed C1.
   g_states[index].advC1Time=rates[1].time;
   g_states[index].advC1High=rates[1].high;
   g_states[index].advC1Low=rates[1].low;
   g_states[index].advC2Open=rates[0].open;
   g_states[index].advC2High=rates[0].high;
   g_states[index].advC2Low=rates[0].low;
   g_states[index].advC1Open=rates[1].open;
   g_states[index].advC1Close=rates[1].close;
   g_states[index].advC2Close=rates[0].close;

   if(advanced!=CRT_NONE)
   {
      g_states[index].advancedFVGQualified=
         IsCRTQualifiedByFVG(index,advanced,rates[0]);
   }

   if(g_states[index].currentBarTime==0)
   {
      g_states[index].currentBarTime=currentTime;

      ENUM_CRT_SIGNAL initial=
         ClassifyCRT(rates[2],rates[1]);

      g_states[index].confirmedSignal=initial;
      g_states[index].confirmedC3Time=currentTime;

      g_states[index].confirmedC1Time=rates[2].time;
      g_states[index].confirmedC2Time=rates[1].time;

      g_states[index].confirmedC3EndTime=
         currentTime+PeriodSeconds(tf);

      g_states[index].confirmedC1High=rates[2].high;
      g_states[index].confirmedC1Low=rates[2].low;

      g_states[index].confirmedC2High=rates[1].high;
      g_states[index].confirmedC2Low=rates[1].low;

      g_states[index].confirmedFVGQualified=false;
      g_states[index].confirmedFVGPresent=false;

      if(initial!=CRT_NONE)
      {
         g_states[index].confirmedFVGPresent=
            CheckCRTFVG(index,initial,rates[1]);

         g_states[index].confirmedFVGQualified=
            (!InpEnableFVGFilter ||
             g_states[index].confirmedFVGPresent);

         AddCRTToHistory(
            index,
            initial,
            rates[2],
            rates[1],
            currentTime,
            g_states[index].confirmedC3EndTime
         );
      }

      UpdateCISD(index);
      UpdateSetup(index);
      return;
   }

   if(currentTime!=g_states[index].currentBarTime)
   {
      g_states[index].currentBarTime=currentTime;

      ENUM_CRT_SIGNAL confirmed=
         ClassifyCRT(rates[2],rates[1]);

      g_states[index].confirmedSignal=confirmed;
      g_states[index].confirmedC3Time=currentTime;

      g_states[index].confirmedC1Time=rates[2].time;
      g_states[index].confirmedC2Time=rates[1].time;

      g_states[index].confirmedC3EndTime=
         currentTime+PeriodSeconds(tf);

      g_states[index].confirmedC1High=rates[2].high;
      g_states[index].confirmedC1Low=rates[2].low;

      g_states[index].confirmedC2High=rates[1].high;
      g_states[index].confirmedC2Low=rates[1].low;

      g_states[index].confirmedFVGQualified=false;
      g_states[index].confirmedFVGPresent=false;

      ResetCISDState(index);

      if(confirmed!=CRT_NONE)
      {
         g_states[index].confirmedFVGPresent=
            CheckCRTFVG(index,confirmed,rates[1]);

         g_states[index].confirmedFVGQualified=
            (!InpEnableFVGFilter ||
             g_states[index].confirmedFVGPresent);

         AddCRTToHistory(
            index,
            confirmed,
            rates[2],
            rates[1],
            currentTime,
            g_states[index].confirmedC3EndTime
         );

      }
   }

   UpdateCISD(index);
   UpdateSetup(index);
}

//------------------------- CHART OBJECT HELPERS --------------------//
void DeleteChartObjects()
{
   ObjectsDeleteAll(0,CHART_PREFIX);
}

void SetChartObjectCommon(string name,color clr)
{
   ObjectSetInteger(0,name,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

//------------------------- CHART TIMEFRAME PAIRING -----------------//
// Which CRT timeframe belongs to which (lower) chart timeframe.
// This mirrors the CISD mapping:  M1<-M15, M3<-M30, M5<-H1,
// M15<-H4, M30<-D1.
ENUM_TIMEFRAMES GetPairedCRTTimeframe(ENUM_TIMEFRAMES chartTF)
{
   switch(chartTF)
   {
      case PERIOD_M1:  return PERIOD_M15;
      case PERIOD_M3:  return PERIOD_M30;
      case PERIOD_M5:  return PERIOD_H1;
      case PERIOD_M15: return PERIOD_H4;
      case PERIOD_M30: return PERIOD_D1;
   }

   return PERIOD_CURRENT;
}

// Chart with a paired CRT timeframe  -> only that CRT is shown.
// Any other chart timeframe          -> only a CRT of the SAME timeframe
//                                       is shown, so CRTs are never drawn
//                                       on a higher chart timeframe.
bool IsCRTVisibleOnChart(ENUM_TIMEFRAMES crtTF)
{
   if(!InpFilterByChartTimeframe)
      return true;

   ENUM_TIMEFRAMES chartTF=(ENUM_TIMEFRAMES)Period();
   ENUM_TIMEFRAMES paired=GetPairedCRTTimeframe(chartTF);

   if(paired!=PERIOD_CURRENT)
      return (crtTF==paired);

   return (crtTF==chartTF);
}

//------------------------- DRAW ONE FVG RECTANGLE ------------------//
void DrawFVGRectangle(ENUM_TIMEFRAMES crtTF,
                      datetime c2Time,
                      ENUM_TIMEFRAMES htf,
                      datetime startTime,
                      datetime endTime,
                      double zoneLow,
                      double zoneHigh,
                      bool bullish)
{
   // Stable unique name: CRT timeframe + C2 time + FVG timeframe
   // + FVG formation time.
   string name=CHART_PREFIX+"FVG_"+
               TimeframeName(crtTF)+"_"+
               IntegerToString((long)c2Time)+"_"+
               TimeframeName(htf)+"_"+
               IntegerToString((long)startTime);

   color zoneColor=
      (bullish ? InpBullFVGColor : InpBearFVGColor);

   if(ObjectFind(0,name)<0)
   {
      ResetLastError();
      if(!ObjectCreate(0,name,OBJ_RECTANGLE,0,
                       startTime,zoneHigh,endTime,zoneLow))
      {
         Print("GloryAlgo: FVG rectangle creation failed: ",
               name," Error: ",GetLastError());
         return;
      }
   }
   else
   {
      ObjectMove(0,name,0,startTime,zoneHigh);
      ObjectMove(0,name,1,endTime,zoneLow);
   }

   SetChartObjectCommon(name,zoneColor);

   ObjectSetInteger(0,name,OBJPROP_STYLE,STYLE_SOLID);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,name,OBJPROP_FILL,true);

   // Draw in front of the chart candles so the zones are visible.
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_RAY_RIGHT,false);
   ObjectSetInteger(0,name,OBJPROP_ZORDER,1);

   string labelName=name+"_LABEL";

   if(ObjectFind(0,labelName)<0)
   {
      ResetLastError();
      if(!ObjectCreate(0,labelName,OBJ_TEXT,0,startTime,zoneHigh))
         Print("GloryAlgo: FVG label creation failed: ",labelName,
               " Error: ",GetLastError());
   }
   else
   {
      ObjectMove(0,labelName,0,startTime,zoneHigh);
   }


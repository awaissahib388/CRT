void MAAnalyzeAll()
{
   if(!Show_Market_Analysis) return;
   // Analyse every configured timeframe independently, plus the mandatory W1/D1/H4 context frames.
   for(int s=0;s<g_symbolCount;s++)
   {
      bool hasW=false,hasD=false,hasH4=false;
      for(int t=0;t<g_timeframeCount;t++)
      {
         ENUM_TIMEFRAMES tf=g_timeframes[t];
         if(tf==PERIOD_W1) hasW=true; if(tf==PERIOD_D1) hasD=true; if(tf==PERIOD_H4) hasH4=true;
         MAFrame f; if(MAAnalyzeFrame(g_symbols[s],tf,f)) MAStoreFrame(f);
      }
      MAFrame f;
      if(!hasW && MAAnalyzeFrame(g_symbols[s],PERIOD_W1,f)) MAStoreFrame(f);
      if(!hasD && MAAnalyzeFrame(g_symbols[s],PERIOD_D1,f)) MAStoreFrame(f);
      if(!hasH4 && MAAnalyzeFrame(g_symbols[s],PERIOD_H4,f)) MAStoreFrame(f);
   }
   int chartH4=MAFindFrame(Symbol(),PERIOD_H4);
   if(chartH4>=0) MADrawPanel();
   MADrawPriceAction();
   datetime now=TimeCurrent();
   int interval=MathMax(1,Save_Analysis_Every_Minutes)*60;
   if(g_lastAnalysisLog==0 || now-g_lastAnalysisLog>=interval)
   {
      for(int i=0;i<g_maFrameCount;i++) MAWriteLog(g_maFrames[i]);
      g_lastAnalysisLog=now;
   }
}

//------------------------- TIMEFRAME PARSER -----------------------//
ENUM_TIMEFRAMES ParseTimeframe(string value)
{
   StringToUpper(value);

   if(value=="M1")  return PERIOD_M1;
   if(value=="M2")  return PERIOD_M2;
   if(value=="M3")  return PERIOD_M3;
   if(value=="M4")  return PERIOD_M4;
   if(value=="M5")  return PERIOD_M5;
   if(value=="M6")  return PERIOD_M6;
   if(value=="M10") return PERIOD_M10;
   if(value=="M12") return PERIOD_M12;
   if(value=="M15") return PERIOD_M15;
   if(value=="M20") return PERIOD_M20;
   if(value=="M30") return PERIOD_M30;

   if(value=="H1")  return PERIOD_H1;
   if(value=="H2")  return PERIOD_H2;
   if(value=="H3")  return PERIOD_H3;
   if(value=="H4")  return PERIOD_H4;
   if(value=="H6")  return PERIOD_H6;
   if(value=="H8")  return PERIOD_H8;
   if(value=="H12") return PERIOD_H12;

   if(value=="D1")  return PERIOD_D1;
   if(value=="W1")  return PERIOD_W1;
   if(value=="MN1") return PERIOD_MN1;

   return PERIOD_CURRENT;
}

//------------------------- TIMEFRAME NAME -------------------------//
string TimeframeName(ENUM_TIMEFRAMES tf)
{
   string name=EnumToString(tf);
   StringReplace(name,"PERIOD_","");
   return name;
}

//------------------------- SIGNAL NAME ----------------------------//
string SignalName(ENUM_CRT_SIGNAL signal)
{
   if(signal==CRT_BULL)   return "BULL";
   if(signal==CRT_BEAR)   return "BEAR";
   if(signal==CRT_DOUBLE) return "DOUBLE";
   return "-";
}

//------------------------- CISD TIMEFRAME MAPPING -----------------//
ENUM_TIMEFRAMES GetCISDTimeframe(ENUM_TIMEFRAMES crtTF)
{
   switch(crtTF)
   {
      case PERIOD_M15: return PERIOD_M1;
      case PERIOD_M30: return PERIOD_M3;
      case PERIOD_H1:  return PERIOD_M5;
      case PERIOD_H2:  return PERIOD_M5;
      case PERIOD_H4:  return PERIOD_M15;
      case PERIOD_D1:  return PERIOD_M30;
      case PERIOD_W1:  return PERIOD_H4;
      case PERIOD_MN1: return PERIOD_D1;
   }

   return PERIOD_CURRENT;
}

//------------------------- SYMBOL LOADING -------------------------//
void AddSymbol(string symbol)
{
   StringTrimLeft(symbol);
   StringTrimRight(symbol);

   if(symbol=="")
      return;

   for(int i=0;i<g_symbolCount;i++)
      if(g_symbols[i]==symbol)
         return;

   if(g_symbolCount>=InpMaxSymbols)
      return;

   if(!SymbolSelect(symbol,true))
   {
      Print("GloryAlgo: Could not select symbol: ",symbol);
      return;
   }

   ArrayResize(g_symbols,g_symbolCount+1);
   g_symbols[g_symbolCount]=symbol;
   g_symbolCount++;
}

void LoadSymbols()
{
   ArrayResize(g_symbols,0);
   g_symbolCount=0;

   if(InpSymbolSource==SYMBOLS_MANUAL ||
      InpSymbolSource==SYMBOLS_BOTH)
   {
      string manual[];
      int count=StringSplit(InpManualSymbols,',',manual);

      for(int i=0;i<count;i++)
         AddSymbol(manual[i]);
   }

   if(InpSymbolSource==SYMBOLS_MARKET_WATCH ||
      InpSymbolSource==SYMBOLS_BOTH)
   {
      int total=SymbolsTotal(true);

      for(int i=0;i<total && g_symbolCount<InpMaxSymbols;i++)
         AddSymbol(SymbolName(i,true));
   }
}

//------------------------- TIMEFRAME LOADING -----------------------//
void LoadTimeframes()
{
   ArrayResize(g_timeframes,0);
   g_timeframeCount=0;

   string parts[];
   int count=StringSplit(InpTimeframes,',',parts);

   for(int i=0;i<count;i++)
   {
      StringTrimLeft(parts[i]);
      StringTrimRight(parts[i]);

      ENUM_TIMEFRAMES tf=ParseTimeframe(parts[i]);

      if(tf==PERIOD_CURRENT)
      {
         Print("GloryAlgo: Unsupported timeframe: ",parts[i]);
         continue;
      }

      bool duplicate=false;

      for(int j=0;j<g_timeframeCount;j++)
         if(g_timeframes[j]==tf)
            duplicate=true;

      if(duplicate)
         continue;

      ArrayResize(g_timeframes,g_timeframeCount+1);
      g_timeframes[g_timeframeCount]=tf;
      g_timeframeCount++;
   }

   for(int a=0;a<g_timeframeCount-1;a++)
   {
      for(int b=a+1;b<g_timeframeCount;b++)
      {
         if(PeriodSeconds(g_timeframes[a])>
            PeriodSeconds(g_timeframes[b]))
         {
            ENUM_TIMEFRAMES temp=g_timeframes[a];
            g_timeframes[a]=g_timeframes[b];
            g_timeframes[b]=temp;
         }
      }
   }
}


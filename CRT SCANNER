         cEarly++;

      if(GradeRank(i)>=1)
         cGood++;
   }

   int activeTotal=cAll;

   // 2) Symbols with setups, best score first.
   int rowSym[];
   int rowBest[];
   int symRows=0;

   for(int s=0;s<g_symbolCount;s++)
   {
      int best=-1;

      for(int t=0;t<tfCount;t++)
      {
         int idx=s*tfCount+t;

         if(idx>=g_stateCount)
            break;

         if(g_states[idx].setupActive &&
            g_states[idx].setupScore>best)
            best=g_states[idx].setupScore;
      }

      if(best<0)
         continue;

      ArrayResize(rowSym,symRows+1);
      ArrayResize(rowBest,symRows+1);
      rowSym[symRows]=s;
      rowBest[symRows]=best;
      symRows++;
   }

   for(int a=0;a<symRows-1;a++)
   {
      for(int b=a+1;b<symRows;b++)
      {
         if(rowBest[b]>rowBest[a])
         {
            int tempSym=rowSym[a];
            int tempBest=rowBest[a];

            rowSym[a]=rowSym[b];
            rowBest[a]=rowBest[b];

            rowSym[b]=tempSym;
            rowBest[b]=tempBest;
         }
      }
   }

   // 3) One display row per setup (filtered), grouped by symbol.
   int dState[];
   bool dFirst[];
   string dTag[];
   int dRows=0;

   int maxRows=MathMax(1,InpDashboardMaxRows);

   for(int q=0;q<symRows && dRows<maxRows;q++)
   {
      int list[];
      int n=CollectRowSetups(rowSym[q],list);

      bool anyBull=false;
      bool anyBear=false;

      for(int k=0;k<n;k++)
      {
         if(g_states[list[k]].setupDir==CRT_BULL)
            anyBull=true;
         else
            anyBear=true;
      }

      string tag="";

      if(n>1)
         tag=((anyBull && anyBear) ? "CONFLICT" : "ALIGNED");

      bool first=true;

      for(int k=0;k<n && dRows<maxRows;k++)
      {
         if(!PassFilter(list[k]))
            continue;

         ArrayResize(dState,dRows+1);
         ArrayResize(dFirst,dRows+1);
         ArrayResize(dTag,dRows+1);

         dState[dRows]=list[k];
         dFirst[dRows]=first;
         dTag[dRows]=(first ? tag : "");

         first=false;
         dRows++;
      }
   }

   // 4) Layout signature (rebuild objects only when this changes).
   string sig=(g_dashboardOpen ? "O" : "M")+
              IntegerToString(activeTotal);

   if(g_dashboardOpen)
   {
      sig+="|F"+IntegerToString(g_filter)+
           "|"+IntegerToString(cBull)+","+IntegerToString(cBear)+","+
           IntegerToString(cEarly)+","+IntegerToString(cGood)+
           "|L"+IntegerToString(g_jnLastCount);

      for(int q=0;q<g_jnLastCount;q++)
         sig+=IntegerToString(g_jnLast[q]);

      sig+=((g_jnWins+g_jnLoss)>0 ? "S1" : "S0");

      for(int r=0;r<dRows;r++)
      {
         sig+="|"+IntegerToString(dState[r])+":"+
              IntegerToString(g_states[dState[r]].setupScore)+":"+
              IntegerToString((int)g_states[dState[r]].setupDir)+":"+
              (g_states[dState[r]].setupEarly ? "E" : "C")+":"+
              (dFirst[r] ? "1" : "0")+":"+dTag[r];
      }
   }

   // 5) Geometry.
   int drawRows=MathMax(1,dRows);

   int panelW=PANEL_W;
   int panelH=ROWS_Y+(drawRows*ROW_H)+8+FOOT_H+PAD;

   if(g_dashboardOpen)
   {
      g_boxW=panelW;
      g_boxH=panelH;
   }
   else
   {
      g_boxW=LOGO_W;
      g_boxH=LOGO_H;
   }

   ClampDashboard();

   if(sig!=g_dashSig)
   {
      DeleteDashboardObjects();
      g_dashSig=sig;
   }

   int x0=g_dashX;
   int y0=g_dashY;

   //---------------- minimized logo ----------------
   if(!g_dashboardOpen)
   {
      CreateRect(PREFIX+"LOGO_BG",x0,y0,LOGO_W,LOGO_H,
                 InpInkColor,InpInkColor);

      CreateText(PREFIX+"LOGO_T","GLORYALGO",
                 x0+10,y0+6,9,InpPanelColor,"Tahoma Bold");

      if(activeTotal>0)
      {
         CreateRect(PREFIX+"LOGO_CHIP",x0+LOGO_W-28,y0+4,22,18,
                    InpPanelColor,InpPanelColor);

         CreateText(PREFIX+"LOGO_N",IntegerToString(activeTotal),
                    x0+LOGO_W-17,y0+13,8,InpInkColor,
                    "Tahoma Bold",ANCHOR_CENTER);
      }

      ChartRedraw(0);
      return;
   }

   //---------------- panel + header ----------------
   color hairline=C'230,227,218';
   color emptyPip=C'207,203,192';
   color neutralZone=C'216,212,200';
   color lossColor=C'196,120,48';
   color goodColor=C'62,142,91';

   CreateRect(PREFIX+"PANEL",x0,y0,panelW,panelH,
              InpPanelColor,InpBorderColor);

   CreateText(PREFIX+"TITLE","CRT SETUPS",
              x0+PAD,y0+12,10,InpInkColor,"Tahoma Bold");

   g_minW=22;
   g_minH=20;
   g_minX=x0+panelW-PAD-g_minW;
   g_minY=y0+8;

   int pillW=78;
   int pillH=20;
   int pillX=g_minX-6-pillW;

   CreateRect(PREFIX+"PILL",pillX,g_minY,pillW,pillH,
              InpInkColor,InpInkColor);

   CreateText(PREFIX+"PILL_T",
              IntegerToString(activeTotal)+" ACTIVE",
              pillX+(pillW/2),g_minY+(pillH/2),8,
              InpPanelColor,"Tahoma Bold",ANCHOR_CENTER);

   CreateRect(PREFIX+"MIN_BG",g_minX,g_minY,g_minW,g_minH,
              InpRowColor,InpBorderColor);

   CreateText(PREFIX+"MIN_T","-",
              g_minX+(g_minW/2),g_minY+(g_minH/2),11,
              InpInkColor,"Tahoma Bold",ANCHOR_CENTER);

   // Killzone indicator.
   int kz=KillzoneId(TimeCurrent());

   string kzName="NO KILLZONE";

   if(kz==1)
      kzName="LDN KILLZONE";
   else if(kz==2)
      kzName="NY KILLZONE";

   CreateText(PREFIX+"KZ",
              ShortToString((ushort)0x25CF)+" "+kzName,
              pillX-14,g_minY+4,8,
              (kz>0 ? goodColor : InpMutedTextColor),
              "Arial",ANCHOR_RIGHT_UPPER);

   //---------------- filter chips ----------------
   int rowX=x0+PAD;
   int rowW=panelW-(2*PAD);

   string chipText[5];
   chipText[0]="ALL "+IntegerToString(cAll);
   chipText[1]="BULL "+IntegerToString(cBull);
   chipText[2]="BEAR "+IntegerToString(cBear);
   chipText[3]="EARLY "+IntegerToString(cEarly);
   chipText[4]="A+/A "+IntegerToString(cGood);

   int chipX=rowX;

   g_chipY=y0+CHIPS_Y;
   g_chipH=20;

   for(int k=0;k<5;k++)
   {
      int cw=(StringLen(chipText[k])*6)+22;

      g_chipX[k]=chipX;
      g_chipW[k]=cw;

      bool on=(g_filter==k);
      string cp=PREFIX+"CHIP"+IntegerToString(k);

      CreateRect(cp,chipX,g_chipY,cw,g_chipH,
                 (on ? InpInkColor : InpPanelColor),
                 (on ? InpInkColor : InpBorderColor));

      CreateText(cp+"_T",chipText[k],
                 chipX+(cw/2),g_chipY+(g_chipH/2),8,
                 (on ? InpPanelColor : InpMutedTextColor),
                 "Tahoma Bold",ANCHOR_CENTER);

      chipX+=cw+6;
   }

   //---------------- column headers ----------------
   int hy=y0+HEADER_Y;

   string heads[7]={"SYMBOL","TF","SIDE","SCORE","RR","PROGRESS  SL > ENTRY > TP2","AGE"};
   int headX[7]={46,206,262,340,470,516,702};

   for(int k=0;k<7;k++)
      CreateText(PREFIX+"HD"+IntegerToString(k),heads[k],
                 rowX+headX[k],hy,7,InpMutedTextColor,"Tahoma Bold");

   CreateRect(PREFIX+"HDLN",rowX,hy+14,rowW,1,
              InpBorderColor,InpBorderColor);

   //---------------- rows ----------------
   int rowsY=y0+ROWS_Y;
   int maxScore=MaxSetupScore();
   int pipCount=MathMin(maxScore,9);
   datetime nowTime=TimeCurrent();

   if(dRows==0)
   {
      CreateText(PREFIX+"EMPTY",
                 (activeTotal==0 ? "No active setups" :
                                   "No setups match this filter"),
                 rowX+46,rowsY+12,InpFontSize,
                 InpMutedTextColor,"Tahoma");
   }

   for(int r=0;r<dRows;r++)
   {
      int si=dState[r];

      int ry=rowsY+(r*ROW_H);
      string rp=PREFIX+"R"+IntegerToString(r)+"_";

      bool bull=(g_states[si].setupDir==CRT_BULL);
      bool early=g_states[si].setupEarly;

      color sideColor=(bull ? InpBullColor : InpBearColor);

      CreateRect(rp+"LN",rowX,ry+ROW_H-1,rowW,1,hairline,hairline);

      // Grade chip.
      CreateRect(rp+"GR",rowX,ry+7,34,24,sideColor,sideColor);

      CreateText(rp+"GRT",GradeText(GradeRank(si)),
                 rowX+17,ry+19,9,clrWhite,"Tahoma Bold",ANCHOR_CENTER);

      // Symbol (shown once per group) + CONFLICT / ALIGNED tag.
      if(dFirst[r])
      {
         CreateText(rp+"SYM",ShortSymbol(g_states[si].symbol),
                    rowX+46,ry+(dTag[r]!="" ? 6 : 11),InpFontSize,
                    InpInkColor,"Tahoma Bold");

         if(dTag[r]!="")
            CreateText(rp+"TAG",dTag[r],
                       rowX+46,ry+22,7,
                       (dTag[r]=="CONFLICT" ? C'138,111,47' :
                                              InpMutedTextColor),
                       "Tahoma Bold");
      }
      else
      {
         CreateText(rp+"SUB",ShortToString((ushort)0x2514),
                    rowX+52,ry+9,10,InpMutedTextColor,"Arial");
      }

      // Timeframe (+ EARLY tag).
      CreateText(rp+"TF",TimeframeName(g_states[si].timeframe),
                 rowX+206,ry+(early ? 6 : 11),InpFontSize,
                 InpInkColor,"Tahoma Bold");

      if(early)
         CreateText(rp+"EARLY","EARLY",rowX+206,ry+22,7,
                    InpMutedTextColor,"Tahoma Bold");

      // Side chip.
      CreateRect(rp+"SD",rowX+262,ry+8,66,22,sideColor,sideColor);

      CreateText(rp+"ARW",
                 ShortToString((ushort)(bull ? 0x25B2 : 0x25BC)),
                 rowX+270,ry+12,8,clrWhite,"Arial");

      CreateText(rp+"SDT",(bull ? "BULL" : "BEAR"),
                 rowX+284,ry+11,InpFontSize,clrWhite,"Tahoma Bold");

      // Score pips + score.
      for(int p=0;p<pipCount;p++)
      {
         color pipColor=(p<g_states[si].setupScore ? sideColor : emptyPip);

         CreateRect(rp+"P"+IntegerToString(p),
                    rowX+340+(p*10),ry+13,7,12,pipColor,pipColor);
      }

      CreateText(rp+"SC",
                 IntegerToString(g_states[si].setupScore)+"/"+
                 IntegerToString(maxScore),
                 rowX+340+(pipCount*10)+4,ry+12,8,
                 InpInkColor,"Tahoma Bold");

      // Planned RR.
      CreateText(rp+"RR",
                 (g_states[si].setupRR>0.0 ?
                  DoubleToString(g_states[si].setupRR,1)+"R" : "--"),
                 rowX+470,ry+11,InpFontSize,InpInkColor,"Tahoma Bold");

      // Progress bar: SL (left) ... entry ... TP2 (right).
      int barX=rowX+516;
      int barY=ry+15;
      int barW=130;

      double liveR=0.0;
      bool hasLive=LiveR(si,liveR);

      double nowPrice=g_states[si].setupEntry;

      if(hasLive)
         nowPrice=SymbolInfoDouble(g_states[si].symbol,
                                   bull ? SYMBOL_BID : SYMBOL_ASK);

      int pe=(int)MathRound(BarPos(si,g_states[si].setupEntry)*barW);
      int pn=(int)MathRound(BarPos(si,nowPrice)*barW);

      int lo=MathMin(pe,pn);
      int hi=MathMax(pe,pn);

      color tint=Lighten(sideColor,0.65);
      color moveColor=(pn>=pe ? sideColor : lossColor);

      CreateRect(rp+"Z1",barX,barY,MathMax(1,pe),8,
                 neutralZone,neutralZone);

      CreateRect(rp+"Z2",barX+pe,barY,MathMax(1,barW-pe),8,
                 tint,tint);

      CreateRect(rp+"Z3",barX+lo,barY,MathMax(1,hi-lo),8,
                 moveColor,moveColor);

      CreateRect(rp+"TE",barX+pe-1,barY-3,2,14,
                 InpInkColor,InpInkColor);

      CreateText(rp+"DOT",ShortToString((ushort)0x25CF),
                 barX+pn,barY+4,11,InpInkColor,"Arial",ANCHOR_CENTER);

      CreateText(rp+"LIVE",
                 (hasLive ?
                  (liveR>=0.0 ? "+" : "")+DoubleToString(liveR,1)+"R" :
                  "--"),
                 barX+barW+10,ry+12,8,
                 (liveR>=0.0 ? InpInkColor : lossColor),
                 "Tahoma Bold");

      // Age since CISD confirmed.
      long ageSeconds=0;

      if(g_states[si].setupFormTime>0)
         ageSeconds=(long)(nowTime-g_states[si].setupFormTime);

      CreateText(rp+"AGE",FormatAge(ageSeconds),
                 rowX+702,ry+12,8,InpMutedTextColor,"Tahoma");

      // Hover text: plain-language checklist of the setup.
      string tip=SetupTooltip(si);

      string parts[]={"GR","GRT","SD","ARW","SDT","SC","RR",
                      "Z1","Z2","Z3","DOT"};

      for(int p=0;p<ArraySize(parts);p++)
         ObjectSetString(0,rp+parts[p],OBJPROP_TOOLTIP,tip);
   }

   //---------------- footer ----------------
   int footY=rowsY+(drawRows*ROW_H)+8;

   CreateText(PREFIX+"STATS",StatsLine(),
              rowX+2,footY+4,8,InpMutedTextColor,"Tahoma Bold");

   if(g_jnLastCount>0)
   {
      int resX=rowX+rowW-(g_jnLastCount*24);

      CreateText(PREFIX+"LASTLBL","LAST",
                 resX-8,footY+5,8,InpMutedTextColor,
                 "Tahoma Bold",ANCHOR_RIGHT_UPPER);

      for(int q=0;q<g_jnLastCount;q++)
      {
         bool win=(g_jnLast[q]==1);
         color rc=(win ? InpBullColor : InpBearColor);
         string rn=PREFIX+"RES"+IntegerToString(q);

         CreateRect(rn,resX+(q*24),footY+2,20,18,rc,rc);

         CreateText(rn+"_T",(win ? "W" : "L"),
                    resX+(q*24)+10,footY+11,8,clrWhite,
                    "Tahoma Bold",ANCHOR_CENTER);
      }
   }

   ChartRedraw(0);
}

//------------------------- SCAN ALL --------------------------------//
void ScanAll()
{
   MAAnalyzeAll();
   for(int i=0;i<g_stateCount;i++)
      ScanState(i);

   DrawChartObjects();
   DrawDashboard();
}

//------------------------- OPEN / MINIMIZE -------------------------//
void OpenDashboard()
{
   if(g_dashboardOpen)
      return;

   g_dashboardOpen=true;
   g_dashSig="";
   GlobalVariableSet("GA_CRT_OPEN",1.0);

   DrawDashboard();
}

void MinimizeDashboard()
{
   if(!g_dashboardOpen)
      return;

   g_dashboardOpen=false;
   g_dashSig="";
   GlobalVariableSet("GA_CRT_OPEN",0.0);

   DrawDashboard();
}

//------------------------- FILTER ----------------------------------//
void SetFilter(int filter)
{
   if(filter<0 || filter>4)
      filter=0;

   g_filter=filter;
   g_dashSig="";

   GlobalVariableSet("GA_CRT_FILTER",(double)filter);

   DrawDashboard();
}

//------------------------- MOUSE HANDLING --------------------------//
// 0 = nothing, 1 = logo, 2 = panel (drag handle),
// 3 = minimize button, 10..14 = filter chips
int HitTest(int mx,int my)
{
   if(mx<g_dashX || my<g_dashY ||
      mx>g_dashX+g_boxW || my>g_dashY+g_boxH)
      return 0;

   if(!g_dashboardOpen)
      return 1;

   if(mx>=g_minX-4 && mx<=g_minX+g_minW+4 &&
      my>=g_minY-4 && my<=g_minY+g_minH+4)
      return 3;

   if(my>=g_chipY && my<=g_chipY+g_chipH)
   {
      for(int k=0;k<5;k++)
      {
         if(mx>=g_chipX[k] && mx<=g_chipX[k]+g_chipW[k])
            return 10+k;
      }
   }

   return 2;
}

// Stops the chart from scrolling while the cursor is on the
// dashboard or while it is being dragged.
void SetScrollLock(bool lock)
{
   if(lock==g_scrollLocked)
      return;

   g_scrollLocked=lock;

   if(lock)
      ChartSetInteger(0,CHART_MOUSE_SCROLL,false);
   else
      ChartSetInteger(0,CHART_MOUSE_SCROLL,g_origScroll);
}

void HandleMouse(int mx,int my,uint flags)
{
   bool down=((flags & 1)!=0);
   int target=HitTest(mx,my);

   SetScrollLock(g_dragging || target!=0);

   if(down && !g_prevDown)
   {
      // Button pressed.
      g_pressTarget=target;
      g_pressX=mx;
      g_pressY=my;
      g_startX=g_dashX;
      g_startY=g_dashY;
      g_dragging=false;
   }
   else if(down && g_prevDown)
   {
      // Button held: drag from the logo or anywhere on the panel.
      if(g_pressTarget==1 || g_pressTarget==2)
      {
         if(!g_dragging &&
            (MathAbs(mx-g_pressX)>4 || MathAbs(my-g_pressY)>4))
            g_dragging=true;

         if(g_dragging)
         {
            g_dashX=g_startX+(mx-g_pressX);
            g_dashY=g_startY+(my-g_pressY);

            DrawDashboard();
         }
      }
   }
   else if(!down && g_prevDown)
   {
      // Button released.
      if(g_dragging)
      {
         SavePosition();
         g_dragging=false;
      }
      else
      {
         if(g_pressTarget==1 && target==1)
         {
            g_prevDown=down;
            OpenDashboard();
            g_pressTarget=0;
            return;
         }

         if(g_pressTarget==3 && target==3)
         {
            g_prevDown=down;
            MinimizeDashboard();
            g_pressTarget=0;
            return;
         }

         if(g_pressTarget>=10 && target==g_pressTarget)
         {
            g_prevDown=down;
            SetFilter(target-10);
            g_pressTarget=0;
            return;
         }
      }

      g_pressTarget=0;
   }

   g_prevDown=down;
}

//------------------------- INITIALIZATION --------------------------//
int OnInit()
{
   LoadSymbols();
   LoadTimeframes();

   if(g_symbolCount<=0)
   {
      Print("GloryAlgo: No valid symbols loaded.");
      return INIT_FAILED;
   }

   if(g_timeframeCount<=0)
   {
      Print("GloryAlgo: No valid timeframes loaded.");
      return INIT_FAILED;
   }

   InitializeStates();

   BuildInitialCRTHistory();

   JournalLoad();
   JournalPrint();

   int interval=InpScanIntervalSeconds;

   if(interval<1)
      interval=1;

   if(!EventSetTimer(interval))
   {
      Print("GloryAlgo: Timer initialization failed. Error: ",
            GetLastError());
      return INIT_FAILED;
   }

   g_origScroll=(bool)ChartGetInteger(0,CHART_MOUSE_SCROLL);
   g_scrollLocked=false;

   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,true);

   LoadPosition();

   if(GlobalVariableCheck("GA_CRT_FILTER"))
      g_filter=(int)GlobalVariableGet("GA_CRT_FILTER");

   if(g_filter<0 || g_filter>4)
      g_filter=0;

   g_dashboardOpen=(GlobalVariableCheck("GA_CRT_OPEN") &&
                    GlobalVariableGet("GA_CRT_OPEN")>0.5);
   g_dashSig="";
   g_firstScanDone=false;

   for(int i=0;i<g_stateCount;i++)
      ScanState(i);

   g_firstScanDone=true;

   MAAnalyzeAll();
   DrawChartObjects();
   DrawDashboard();

   Print("GloryAlgo CRT Scanner v1.97 initialized. Symbols: ",
         g_symbolCount,
         " | Timeframes: ",g_timeframeCount,
         " | Min setup score: ",InpMinSetupScore,"/",MaxSetupScore(),
         " | FVG filter: ",InpEnableFVGFilter,
         " | CISD: ",InpEnableCISD);

   return INIT_SUCCEEDED;
}

//------------------------- TIMER -----------------------------------//
void OnTimer()
{
   ScanAll();
}

//------------------------- CHART INTERACTION ------------------------//
void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id==CHARTEVENT_MOUSE_MOVE)
   {
      HandleMouse((int)lparam,
                  (int)dparam,
                  (uint)StringToInteger(sparam));
      return;
   }

   if(id==CHARTEVENT_CHART_CHANGE)
   {
      DrawDashboard();
      return;
   }
}

//------------------------- TICK ------------------------------------//
void OnTick()
{
   // Timer-based scanning checks all selected symbols/timeframes.
}

//------------------------- DEINITIALIZATION ------------------------//
void OnDeinit(const int reason)
{
   EventKillTimer();

   ChartSetInteger(0,CHART_MOUSE_SCROLL,g_origScroll);
   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,false);

   DeleteAllObjects();
   ObjectsDeleteAll(0,MA_PREFIX);
   ObjectsDeleteAll(0,PA_PREFIX);

   ChartRedraw(0);
}

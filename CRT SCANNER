bool MAIsPivotHigh(const MqlRates &r[],int i,int left,int right)
{
   double v=r[i].high;
   for(int k=1;k<=left;k++) if(r[i+k].high>=v) return false;
   for(int k=1;k<=right;k++) if(r[i-k].high>v) return false;
   return true;
}
bool MAIsPivotLow(const MqlRates &r[],int i,int left,int right)
{
   double v=r[i].low;
   for(int k=1;k<=left;k++) if(r[i+k].low<=v) return false;
   for(int k=1;k<=right;k++) if(r[i-k].low<v) return false;
   return true;
}

double MAATR(const MqlRates &r[],int count,int shift,int period)
{
   if(shift+period+1>=count || period<1) return 0.0;
   double sum=0.0;
   for(int i=shift;i<shift+period;i++)
   {
      double tr=MathMax(r[i].high-r[i].low,
               MathMax(MathAbs(r[i].high-r[i+1].close),MathAbs(r[i].low-r[i+1].close)));
      sum+=tr;
   }
   return sum/period;
}

void MAAddSwing(MASwing &swings[],int &n,datetime t,double price,bool high,bool major,string relation)
{
   if(n>0 && swings[n-1].time==t && swings[n-1].isHigh==high) return;
   if(ArrayResize(swings,n+1)!=n+1) return;
   swings[n].time=t; swings[n].price=price; swings[n].isHigh=high;
   swings[n].isMajor=major; swings[n].relation=relation; n++;
}

string MACompare(double value,double previous,double tolerance,bool high)
{
   if(MathAbs(value-previous)<=tolerance) return high ? "EQH" : "EQL";
   if(high) return value>previous ? "HH" : "LH";
   return value>previous ? "HL" : "LL";
}

int MAFindFrame(string symbol,ENUM_TIMEFRAMES tf)
{
   for(int i=0;i<g_maFrameCount;i++)
      if(g_maFrames[i].symbol==symbol && g_maFrames[i].tf==tf) return i;
   return -1;
}

void MAStoreFrame(const MAFrame &f)
{
   int i=MAFindFrame(f.symbol,f.tf);
   if(i<0)
   {
      i=g_maFrameCount;
      if(ArrayResize(g_maFrames,g_maFrameCount+1)!=g_maFrameCount+1) return;
      g_maFrameCount++;
   }
   g_maFrames[i]=f;
}

double MAPivotDeparture(const MqlRates &r[],int count,int index,bool high)
{
   double move=0.0;
   int right=MathMax(1,Major_Swing_Right_Bars);
   for(int k=1;k<=right && index-k>=0;k++)
   {
      double candidate=(high ? r[index].high-r[index-k].low : r[index-k].high-r[index].low);
      if(candidate>move) move=candidate;
   }
   return move;
}

bool MAAnalyzeFrame(string symbol,ENUM_TIMEFRAMES tf,MAFrame &out)
{
   int cached=MAFindFrame(symbol,tf);
   datetime newestClosed=iTime(symbol,tf,1);
   if(cached>=0 && newestClosed>0 && g_maFrames[cached].lastClosedBar==newestClosed)
   {out=g_maFrames[cached];return true;}
   out.symbol=symbol; out.tf=tf; out.state=MA_STATE_INSUFFICIENT; out.score=0;
   out.lastMajorHigh=0.0; out.lastMajorLow=0.0; out.majorHighTime=0; out.majorLowTime=0;
   out.protectedHigh=0.0; out.protectedLow=0.0; out.protectedHighActive=false; out.protectedLowActive=false;
   out.bullBOS=false; out.bearBOS=false; out.bullMSS=false; out.bearMSS=false;
   out.rangeHigh=0.0; out.rangeLow=0.0; out.eq=0.0; out.q25=0.0; out.q75=0.0; out.rangePos=0; out.rangeValid=false;
   out.bullSweep=false; out.bearSweep=false; out.bullFVG=false; out.bearFVG=false;
   out.demandActive=false; out.supplyActive=false; out.demandLow=0.0; out.demandHigh=0.0; out.supplyLow=0.0; out.supplyHigh=0.0;
   out.bullishEngulf=false; out.bearishEngulf=false; out.failedBreakUp=false; out.failedBreakDown=false;
   out.pocFound=false; out.pocLevel=0.0; out.pocTests=0; out.expansionUp=false; out.expansionDown=false;
   out.rangeAcceptedUp=false; out.rangeAcceptedDown=false; out.bullRetest=false; out.bearRetest=false;
   out.bullVI=false; out.bearVI=false; out.bullIFVG=false; out.bearIFVG=false;
   out.bullEngulfFlip=false; out.bearEngulfFlip=false; out.viLow=0.0; out.viHigh=0.0; out.kissingCandle=false; out.kissingLevel=0.0;
   out.supportTrendlineValid=false; out.resistanceTrendlineValid=false; out.supportTrendlineTouch=false; out.resistanceTrendlineTouch=false;
   out.supportTrendlineNow=0.0; out.resistanceTrendlineNow=0.0; out.bullQML=false; out.bearQML=false; out.bullQMLLevel=0.0; out.bearQMLLevel=0.0;
   out.bullInducement=false; out.bearInducement=false; out.inducementPrice=0.0; out.dolPrice=0.0; out.modelTarget=0.0; out.dolName="NONE";
   out.demandFlip=false; out.supplyFlip=false; out.mitigationDemand=false; out.mitigationSupply=false;
   out.demandFreshness=0; out.supplyFreshness=0; out.demandMissedBars=0; out.supplyMissedBars=0; out.liquiditySNR=false; out.lastClosedBar=0;
   MqlRates r[]; ArraySetAsSeries(r,true);
   int need=MathMax(Bars_To_Check,150);
   int copied=CopyRates(symbol,tf,0,need,r);
   if(copied<MathMax(Major_Swing_Left_Bars+Major_Swing_Right_Bars+Average_Range_Period+10,60)) return false;
   out.lastClosedBar=r[1].time;
   MASwing major[]; MASwing minor[]; int majorN=0; int minorN=0;
   double tol=MAATR(r,copied,1,Average_Range_Period)*Equal_High_Low_Tolerance;
   int lastHighBar=-100000,lastLowBar=-100000;
   for(int i=copied-1-Major_Swing_Right_Bars;i>=Major_Swing_Right_Bars;i--)
   {
      bool mh=MAIsPivotHigh(r,i,Major_Swing_Left_Bars,Major_Swing_Right_Bars);
      bool ml=MAIsPivotLow(r,i,Major_Swing_Left_Bars,Major_Swing_Right_Bars);
      bool nh=MAIsPivotHigh(r,i,Small_Swing_Left_Bars,Small_Swing_Right_Bars);
      bool nl=MAIsPivotLow(r,i,Small_Swing_Left_Bars,Small_Swing_Right_Bars);
      double atr=MAATR(r,copied,i,Average_Range_Period);
      if(nh && i-lastHighBar>=Minimum_Bars_Between_Swings)
      {
         string rel="";
         for(int z=minorN-1;z>=0;z--) if(minor[z].isHigh){rel=MACompare(r[i].high,minor[z].price,tol,true);break;}
         MAAddSwing(minor,minorN,r[i].time,r[i].high,true,false,rel); lastHighBar=i;
         bool majorFlag=(mh && atr>0.0 && MAPivotDeparture(r,copied,i,true)>=Minimum_Major_Swing_Size*atr);
         if(majorFlag)
         {
            string mr=""; for(int z=majorN-1;z>=0;z--) if(major[z].isHigh){mr=MACompare(r[i].high,major[z].price,tol,true);break;}
            MAAddSwing(major,majorN,r[i].time,r[i].high,true,true,mr);
         }
      }
      if(nl && i-lastLowBar>=Minimum_Bars_Between_Swings)
      {
         string rel="";
         for(int z=minorN-1;z>=0;z--) if(!minor[z].isHigh){rel=MACompare(r[i].low,minor[z].price,tol,false);break;}
         MAAddSwing(minor,minorN,r[i].time,r[i].low,false,false,rel); lastLowBar=i;
         bool majorFlag=(ml && atr>0.0 && MAPivotDeparture(r,copied,i,false)>=Minimum_Major_Swing_Size*atr);
         if(majorFlag)
         {
            string mr=""; for(int z=majorN-1;z>=0;z--) if(!major[z].isHigh){mr=MACompare(r[i].low,major[z].price,tol,false);break;}
            MAAddSwing(major,majorN,r[i].time,r[i].low,false,true,mr);
         }
      }
   }
   int hi1=-1,hi2=-1,lo1=-1,lo2=-1;
   for(int z=majorN-1;z>=0;z--)
   {
      if(major[z].isHigh){if(hi1<0) hi1=z; else if(hi2<0){hi2=z;}}
      else {if(lo1<0) lo1=z; else if(lo2<0){lo2=z;}}
      if(hi2>=0 && lo2>=0) break;
   }
   if(hi1>=0){out.lastMajorHigh=major[hi1].price;out.majorHighTime=major[hi1].time;}
   if(lo1>=0){out.lastMajorLow=major[lo1].price;out.majorLowTime=major[lo1].time;}
   double buffer=MAATR(r,copied,1,Average_Range_Period)*Break_Confirmation_Buffer;
   bool bullSeq=false,bearSeq=false;
   if(hi1>=0 && hi2>=0 && lo1>=0 && lo2>=0)
   {
      string hs=MACompare(major[hi1].price,major[hi2].price,tol,true);
      string ls=MACompare(major[lo1].price,major[lo2].price,tol,false);
      bullSeq=(hs=="HH" && ls=="HL");
      bearSeq=(hs=="LH" && ls=="LL");
   }
   // Reconstruct the latest historical major BOS from closed candles so protected swings persist.
   int lastBullBreakBar=-1,lastBearBreakBar=-1;
   int bullBrokenSwing=-1,bearBrokenSwing=-1;
   for(int z=0;z<majorN;z++)
   {
      int swingBar=iBarShift(symbol,tf,major[z].time,false);
      if(swingBar<2) continue;
      for(int j=1;j<swingBar;j++)
      {
         if(major[z].isHigh && r[j+1].close<=major[z].price+buffer && r[j].close>major[z].price+buffer)
         {
            if(lastBullBreakBar<0 || j<lastBullBreakBar){lastBullBreakBar=j;bullBrokenSwing=z;}
            break;
         }
         if(!major[z].isHigh && r[j+1].close>=major[z].price-buffer && r[j].close<major[z].price-buffer)
         {
            if(lastBearBreakBar<0 || j<lastBearBreakBar){lastBearBreakBar=j;bearBrokenSwing=z;}
            break;
         }
      }
   }
   out.bullBOS=(lastBullBreakBar==1);
   out.bearBOS=(lastBearBreakBar==1);
   bool latestBullStructure=(lastBullBreakBar>=0 && (lastBearBreakBar<0 || lastBullBreakBar<lastBearBreakBar));
   bool latestBearStructure=(lastBearBreakBar>=0 && (lastBullBreakBar<0 || lastBearBreakBar<lastBullBreakBar));
   if(latestBullStructure && bullBrokenSwing>=0)
   {
      datetime breakTime=r[lastBullBreakBar].time;
      for(int z=majorN-1;z>=0;z--)
         if(!major[z].isHigh && major[z].time<breakTime)
         {out.protectedLow=major[z].price;out.protectedLowActive=true;break;}
   }
   if(latestBearStructure && bearBrokenSwing>=0)
   {
      datetime breakTime=r[lastBearBreakBar].time;
      for(int z=majorN-1;z>=0;z--)
         if(major[z].isHigh && major[z].time<breakTime)
         {out.protectedHigh=major[z].price;out.protectedHighActive=true;break;}
   }
   out.bullMSS=(latestBearStructure && out.protectedHighActive && r[1].close>out.protectedHigh+buffer && r[2].close<=out.protectedHigh+buffer);
   out.bearMSS=(latestBullStructure && out.protectedLowActive && r[1].close<out.protectedLow-buffer && r[2].close>=out.protectedLow-buffer);
   bool bullProtectedBroken=(out.protectedLowActive && r[1].close<out.protectedLow-buffer);
   bool bearProtectedBroken=(out.protectedHighActive && r[1].close>out.protectedHigh+buffer);
   if(out.bullMSS || out.bearMSS || bullProtectedBroken || bearProtectedBroken) out.state=MA_STATE_TRANSITION;
   else if(latestBullStructure && !bullProtectedBroken) out.state=MA_STATE_BULL;
   else if(latestBearStructure && !bearProtectedBroken) out.state=MA_STATE_BEAR;
   else if(bullSeq) out.state=MA_STATE_BULL;
   else if(bearSeq) out.state=MA_STATE_BEAR;
   else out.state=MA_STATE_RANGE;
   if(out.state==MA_STATE_BULL) out.score=(out.bullBOS || bullSeq ? 2 : 1);
   else if(out.state==MA_STATE_BEAR) out.score=(out.bearBOS || bearSeq ? -2 : -1);
   else out.score=0;
   // Latest H4/HTF dealing-range candidate: latest confirmed major high and low.
   if(hi1>=0 && lo1>=0 && out.lastMajorHigh>out.lastMajorLow)
   {
      out.rangeHigh=out.lastMajorHigh; out.rangeLow=out.lastMajorLow;
      out.eq=(out.rangeHigh+out.rangeLow)*0.5;
      out.q25=out.rangeLow+0.25*(out.rangeHigh-out.rangeLow);
      out.q75=out.rangeLow+0.75*(out.rangeHigh-out.rangeLow);
      out.rangeValid=true;
      double pos=(r[1].close-out.rangeLow)/(out.rangeHigh-out.rangeLow);
      if(pos<0.0) out.rangePos=-1; else if(pos<0.25) out.rangePos=1;
      else if(pos<0.50) out.rangePos=2; else if(pos<0.75) out.rangePos=3;
      else if(pos<=1.0) out.rangePos=4; else out.rangePos=5;
   }
   // Liquidity sweep/reclaim on latest closed candle against prior major boundaries.
   if(out.lastMajorLow>0.0) out.bullSweep=(r[1].low<out.lastMajorLow-buffer && r[1].close>out.lastMajorLow);
   if(out.lastMajorHigh>0.0) out.bearSweep=(r[1].high>out.lastMajorHigh+buffer && r[1].close<out.lastMajorHigh);
   // FVG lifecycle snapshot: latest closed three-candle imbalance not yet fully traversed.
   for(int i=2;i<MathMin(copied-2,Bars_To_Find_Recent_Patterns+2);i++)
   {
      if(r[i+2].high<r[i].low) {if(r[1].low<=r[i].low && r[1].high>=r[i+2].high) out.bullFVG=true;}
      if(r[i+2].low>r[i].high) {if(r[1].high>=r[i].high && r[1].low<=r[i+2].low) out.bearFVG=true;}
   }
   // Engulfing is body-to-body and uses only closed candles.
   double pBodyHi=MathMax(r[2].open,r[2].close),pBodyLo=MathMin(r[2].open,r[2].close);
   double cBodyHi=MathMax(r[1].open,r[1].close),cBodyLo=MathMin(r[1].open,r[1].close);
   out.bullishEngulf=(r[1].close>r[1].open && r[2].close<r[2].open && cBodyHi>=pBodyHi && cBodyLo<=pBodyLo);
   out.bearishEngulf=(r[1].close<r[1].open && r[2].close>r[2].open && cBodyHi>=pBodyHi && cBodyLo<=pBodyLo);
   // Failed break/reclaim of most recent major boundaries.
   out.failedBreakUp=(out.lastMajorHigh>0.0 && r[1].high>out.lastMajorHigh+buffer && r[1].close<out.lastMajorHigh);
   out.failedBreakDown=(out.lastMajorLow>0.0 && r[1].low<out.lastMajorLow-buffer && r[1].close>out.lastMajorLow);
   // Range expansion is a close beyond a boundary; not a wick-only event.
   out.expansionUp=(out.rangeValid && r[1].close>out.rangeHigh+buffer);
   out.expansionDown=(out.rangeValid && r[1].close<out.rangeLow-buffer);
   // Price Control Zone: cluster repeated approaches around a historic key close.
   // A candidate needs multiple touches and multiple failures to hold a close beyond it.
   double symPoint=SymbolInfoDouble(symbol,SYMBOL_POINT);
   double pocTol=MathMax(symPoint*Key_Level_Tolerance_Points,tol);
   int bestTests=0; double bestLevel=0.0;
   int scanLimit=MathMin(copied-2,MathMax(30,Bars_To_Find_Recent_Patterns*8));
   for(int a=2;a<scanLimit;a++)
   {
      double candidate=r[a].close; int touches=0; int failed=0;
      for(int b=1;b<scanLimit;b++)
      {
         bool intersects=(r[b].low<=candidate+pocTol && r[b].high>=candidate-pocTol);
         if(intersects)
         {
            touches++;
            if((r[b].close<candidate-pocTol && r[b].high>candidate+pocTol) ||
               (r[b].close>candidate+pocTol && r[b].low<candidate-pocTol)) failed++;
         }
      }
      if(touches>=Minimum_Rejections_For_Key_Level && failed>=1 && touches>bestTests)
      {bestTests=touches;bestLevel=candidate;}
   }
   if(bestTests>=Minimum_Rejections_For_Key_Level){out.pocFound=true;out.pocLevel=bestLevel;out.pocTests=bestTests;}

   // Supply/demand origins are tied to a confirmed structural break, not arbitrary candles.
   if(lastBullBreakBar>=1 && lastBullBreakBar<=Bars_To_Find_Recent_Patterns)
      for(int i=lastBullBreakBar+1;i<MathMin(copied,lastBullBreakBar+Bars_To_Find_Recent_Patterns+2);i++)
         if(r[i].close<r[i].open){out.demandLow=r[i].low;out.demandHigh=r[i].open;out.demandActive=true;break;}
   if(lastBearBreakBar>=1 && lastBearBreakBar<=Bars_To_Find_Recent_Patterns)
      for(int i=lastBearBreakBar+1;i<MathMin(copied,lastBearBreakBar+Bars_To_Find_Recent_Patterns+2);i++)
         if(r[i].close>r[i].open){out.supplyLow=r[i].open;out.supplyHigh=r[i].high;out.supplyActive=true;break;}

   // Range expansion is accepted only after a second closed candle holds outside the range.
   if(out.rangeValid && copied>3)
   {
      out.rangeAcceptedUp=(r[1].close>out.rangeHigh+buffer && r[2].close>out.rangeHigh+buffer);
      out.rangeAcceptedDown=(r[1].close<out.rangeLow-buffer && r[2].close<out.rangeLow-buffer);
   }

   // FVG retest: latest close returns to a previously broken imbalance boundary and holds beyond it.
   for(int i=3;i<MathMin(copied-2,Bars_To_Find_Recent_Patterns+8);i++)
   {
      if(r[i+2].high<r[i].low)
      {
         double zl=r[i+2].high, zh=r[i].low;
         bool priorBreak=false;
         for(int j=i-1;j>=2;j--) if(r[j].close>zh+buffer){priorBreak=true;break;}
         if(priorBreak && r[1].low<=zh+pocTol && r[1].high>=zl-pocTol && r[1].close>zh) out.bullRetest=true;
      }
      if(r[i+2].low>r[i].high)
      {
         double zl=r[i].high, zh=r[i+2].low;
         bool priorBreak=false;
         for(int j=i-1;j>=2;j--) if(r[j].close<zl-buffer){priorBreak=true;break;}
         if(priorBreak && r[1].high>=zl-pocTol && r[1].low<=zh+pocTol && r[1].close<zl) out.bearRetest=true;
         bool inverted=false;
         for(int j=i-1;j>=2;j--) if(r[j].close>zh+buffer){inverted=true;break;}
         if(inverted && r[1].low<=zh+pocTol && r[1].high>=zl-pocTol && r[1].close>zh) out.bullIFVG=true;
      }
      if(r[i+2].high<r[i].low)
      {
         double zl=r[i+2].high, zh=r[i].low;
         bool inverted=false;
         for(int j=i-1;j>=2;j--) if(r[j].close<zl-buffer){inverted=true;break;}
         if(inverted && r[1].high>=zl-pocTol && r[1].low<=zh+pocTol && r[1].close<zl) out.bearIFVG=true;
      }
   }

   // Volume Imbalance (VI): two-candle open/close separation as defined in the trading plan.
   // It is kept separate from the three-candle wick-based FVG.
   if(copied>3)
   {
      if(r[1].close>r[2].open && r[1].low>r[2].high)
      {out.bullVI=true;out.viLow=r[2].high;out.viHigh=r[1].low;}
      else if(r[1].close<r[2].open && r[1].high<r[2].low)
      {out.bearVI=true;out.viLow=r[1].high;out.viHigh=r[2].low;}
   }

   // Kissing candle / gap-bar SNR: preserve the first candle's close as the level.
   // This is a candidate, not an assertion that every gap is a valid HTF decision level.
   if(PeriodSeconds(tf)>=PeriodSeconds(PERIOD_H1))
   {
      bool gapUp=(r[1].low>r[2].high);
      bool gapDown=(r[1].high<r[2].low);
      if(gapUp || gapDown){out.kissingCandle=true;out.kissingLevel=r[2].close;}
   }

   // Trendlines: use the two latest confirmed major lows/highs; require a third
   // touch without a closed candle breaking the line.
   int lowA=-1,lowB=-1,highA=-1,highB=-1;
   for(int z=majorN-1;z>=0;z--)
   {
      if(!major[z].isHigh){if(lowA<0)lowA=z;else if(lowB<0)lowB=z;}
      else {if(highA<0)highA=z;else if(highB<0)highB=z;}
      if(lowB>=0 && highB>=0)break;
   }
   if(lowA>=0 && lowB>=0 && major[lowA].price>major[lowB].price)
   {
      int a=iBarShift(symbol,tf,major[lowB].time,false),b=iBarShift(symbol,tf,major[lowA].time,false);
      if(a>b && b>=1)
      {
         double lineNow=major[lowB].price+(major[lowA].price-major[lowB].price)*(double)(a-1)/(double)(a-b);
         bool touched=false,broken=false;
         for(int j=a-1;j>=1;j--)
         {
            double lv=major[lowB].price+(major[lowA].price-major[lowB].price)*(double)(a-j)/(double)(a-b);
            if(j<b) continue;
            if(r[j].low<=lv+pocTol && r[j].high>=lv-pocTol) touched=true;
            if(r[j].close<lv-buffer) broken=true;
         }
         out.supportTrendlineValid=(touched && !broken);out.supportTrendlineTouch=(r[1].low<=lineNow+pocTol && r[1].high>=lineNow-pocTol);
         out.supportTrendlineNow=lineNow;
      }
   }
   if(highA>=0 && highB>=0 && major[highA].price<major[highB].price)
   {
      int a=iBarShift(symbol,tf,major[highB].time,false),b=iBarShift(symbol,tf,major[highA].time,false);
      if(a>b && b>=1)
      {
         double lineNow=major[highB].price+(major[highA].price-major[highB].price)*(double)(a-1)/(double)(a-b);
         bool touched=false,broken=false;
         for(int j=a-1;j>=1;j--)
         {
            double lv=major[highB].price+(major[highA].price-major[highB].price)*(double)(a-j)/(double)(a-b);
            if(j<b) continue;
            if(r[j].high>=lv-pocTol && r[j].low<=lv+pocTol) touched=true;
            if(r[j].close>lv+buffer) broken=true;
         }
         out.resistanceTrendlineValid=(touched && !broken);out.resistanceTrendlineTouch=(r[1].high>=lineNow-pocTol && r[1].low<=lineNow+pocTol);
         out.resistanceTrendlineNow=lineNow;
      }
   }

   // QML candidates: H&S-style five-pivot structure, with the required engulfing
   // confirmation on the latest closed candle. The right shoulder is the level.
   if(majorN>=5)
   {
      MASwing p0=major[majorN-5],p1=major[majorN-4],p2=major[majorN-3],p3=major[majorN-2],p4=major[majorN-1];
      if(p0.isHigh && !p1.isHigh && p2.isHigh && !p3.isHigh && p4.isHigh)
      {
         bool shoulders=MathAbs(p0.price-p4.price)<=MathMax(tol,(p2.price-p1.price)*0.25);
         if(p2.price>p0.price+tol && p2.price>p4.price+tol && shoulders && out.bearishEngulf)
         {out.bearQML=true;out.bearQMLLevel=p4.price;}
      }
      if(!p0.isHigh && p1.isHigh && !p2.isHigh && p3.isHigh && !p4.isHigh)
      {
         bool shoulders=MathAbs(p0.price-p4.price)<=MathMax(tol,(p1.price-p2.price)*0.25);
         if(p2.price<p0.price-tol && p2.price<p4.price-tol && shoulders && out.bullishEngulf)
         {out.bullQML=true;out.bullQMLLevel=p4.price;}
      }
   }

   // RANGE / DOL / PROJECTED TARGET.
   // A sell-side sweep and reclaim points toward buy-side liquidity; a
   // buy-side sweep and reclaim points toward sell-side liquidity.
   // Target = one dealing-range height projected from the manipulation wick.
   // This target is independent of the CRT setup take-profit.
   if(out.rangeValid)
   {
      double dealingRange=out.rangeHigh-out.rangeLow;
      if(out.bullSweep && !out.bearSweep)
      {
         out.dolPrice=out.rangeHigh;
         out.dolName="BUY-SIDE LIQUIDITY";
         out.modelTarget=r[1].low+dealingRange;
      }
      else if(out.bearSweep && !out.bullSweep)
      {
         out.dolPrice=out.rangeLow;
         out.dolName="SELL-SIDE LIQUIDITY";
         out.modelTarget=r[1].high-dealingRange;
      }
      else if(out.state==MA_STATE_BULL ||
              (out.state==MA_STATE_RANGE && r[1].close<out.eq))
      {
         out.dolPrice=out.rangeHigh;
         out.dolName="BUY-SIDE LIQUIDITY";
      }
      else
      {
         out.dolPrice=out.rangeLow;
         out.dolName="SELL-SIDE LIQUIDITY";
      }

      for(int z=minorN-1;z>=0;z--)
      {
         if(out.dolName=="BUY-SIDE LIQUIDITY" && !minor[z].isHigh &&
            minor[z].time<r[1].time)
         {out.bullInducement=true;out.inducementPrice=minor[z].price;break;}
         if(out.dolName=="SELL-SIDE LIQUIDITY" && minor[z].isHigh &&
            minor[z].time<r[1].time)
         {out.bearInducement=true;out.inducementPrice=minor[z].price;break;}
      }
   }

   // SNR lifecycle for the active origin zones. Wick/body contact is recorded separately;
   // a close beyond the far edge marks the zone broken. Missed bars count untouched closes.
   if(out.demandActive)
   {
      for(int j=1;j<MathMin(copied,Bars_To_Find_Recent_Patterns+12);j++)
      {
         bool wick=(r[j].low<=out.demandHigh && r[j].high>=out.demandLow);
         bool body=(MathMax(r[j].open,r[j].close)>=out.demandLow && MathMin(r[j].open,r[j].close)<=out.demandHigh);
         if(r[j].close<out.demandLow-buffer){out.demandFreshness=3;break;}
         if(body){out.demandFreshness=2;break;}
         if(wick){out.demandFreshness=1;break;}
         out.demandMissedBars++;
      }
      out.mitigationDemand=(r[1].low<=out.demandHigh && r[1].high>=out.demandLow && r[1].close>out.demandHigh);
      out.supplyFlip=(r[2].close<out.demandLow && r[1].high>=out.demandLow && r[1].close<out.demandLow);
   }
   if(out.supplyActive)
   {
      for(int j=1;j<MathMin(copied,Bars_To_Find_Recent_Patterns+12);j++)
      {
         bool wick=(r[j].high>=out.supplyLow && r[j].low<=out.supplyHigh);
         bool body=(MathMax(r[j].open,r[j].close)>=out.supplyLow && MathMin(r[j].open,r[j].close)<=out.supplyHigh);
         if(r[j].close>out.supplyHigh+buffer){out.supplyFreshness=3;break;}
         if(body){out.supplyFreshness=2;break;}
         if(wick){out.supplyFreshness=1;break;}
         out.supplyMissedBars++;
      }
      out.mitigationSupply=(r[1].high>=out.supplyLow && r[1].low<=out.supplyHigh && r[1].close<out.supplyLow);
      out.demandFlip=(r[2].close>out.supplyHigh && r[1].low<=out.supplyHigh && r[1].close>out.supplyHigh);
   }

   // Failed-engulfing SNR flips: the engulfed candle close becomes the decision level.
   for(int i=3;i<MathMin(copied-1,Bars_To_Find_Recent_Patterns+20);i++)
   {
      double level=r[i+1].close;
      bool priorBullBreak=false,priorBearBreak=false;
      for(int j=i-1;j>=2;j--)
      {
         if(r[j].close>level+buffer) priorBullBreak=true;
         if(r[j].close<level-buffer) priorBearBreak=true;
      }
      if(priorBullBreak && r[1].low<=level+pocTol && r[1].close>level) out.bullEngulfFlip=true;
      if(priorBearBreak && r[1].high>=level-pocTol && r[1].close<level) out.bearEngulfFlip=true;
   }

   // Failed engulfing-bar SNR: the level is the engulfed candle's close.
   // A sweep at that level plus close back inside the previous candle is LS + SNR.
   if(out.bullishEngulf || out.bearishEngulf)
   {
      double snr=(out.bullishEngulf ? r[2].close : r[2].close);
      out.liquiditySNR=((r[1].high>r[2].high && r[1].close<r[2].high) ||
                        (r[1].low<r[2].low && r[1].close>r[2].low));
      if(snr>0.0) out.kissingLevel=(out.kissingCandle ? out.kissingLevel : snr);
   }
   return true;
}

int MAFrameScore(string symbol,ENUM_TIMEFRAMES tf)
{
   int i=MAFindFrame(symbol,tf); return (i>=0 ? g_maFrames[i].score : 0);
}

string MARangeLocation(int pos)
{
   if(pos<0) return "BELOW RANGE";
   if(pos==1) return "LOWER QUARTER";
   if(pos==2) return "DISCOUNT";
   if(pos==3) return "PREMIUM";
   if(pos==4) return "UPPER QUARTER";
   if(pos==5) return "ABOVE RANGE";
   return "UNKNOWN";
}

int MAWeightedBias(string symbol,double &normalised,string &conflict)
{
   int w=MAFindFrame(symbol,PERIOD_W1);
   int d=MAFindFrame(symbol,PERIOD_D1);
   int h=MAFindFrame(symbol,PERIOD_H4);
   int intraday=-1;
   // The chart timeframe is the local refinement when it is below H4.
   ENUM_TIMEFRAMES chartTf=(ENUM_TIMEFRAMES)Period();
   if(PeriodSeconds(chartTf)<PeriodSeconds(PERIOD_H4)) intraday=MAFindFrame(symbol,chartTf);
   double total=0.0,used=0.0;
   if(w>=0){total+=0.40*g_maFrames[w].score;used+=0.40;}
   if(d>=0){total+=0.30*g_maFrames[d].score;used+=0.30;}
   if(h>=0){total+=0.20*g_maFrames[h].score;used+=0.20;}
   if(intraday>=0 && intraday!=w && intraday!=d && intraday!=h){total+=0.10*g_maFrames[intraday].score;used+=0.10;}
   normalised=(used>0.0 ? total/used : 0.0);
   conflict="";
   if(w>=0 && d>=0 && g_maFrames[w].score*g_maFrames[d].score<0) conflict="W1 vs D1";
   if(d>=0 && h>=0 && g_maFrames[d].score*g_maFrames[h].score<0)
      conflict+=(conflict=="" ? "D1 vs H4" : "; D1 vs H4");
   if(h>=0 && intraday>=0 && g_maFrames[h].score*g_maFrames[intraday].score<0)
      conflict+=(conflict=="" ? "H4 vs LTF" : "; H4 vs LTF");
   if(normalised>=0.75) return MA_STATE_BULL;
   if(normalised<=-0.75) return MA_STATE_BEAR;
   if(normalised>=0.25 || normalised<=-0.25) return MA_STATE_TRANSITION;
   return MA_STATE_RANGE;
}

string MAFreshnessText(int state)
{

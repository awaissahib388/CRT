// A CRT candidate is closed only once. Keep a bounded in-memory tombstone
// registry so a historical/early candidate cannot be reactivated on the
// next timer/tick scan after its outcome has already been recorded.
struct ClosedSetupKey
{
   string symbol;
   ENUM_TIMEFRAMES timeframe;
   ENUM_CRT_SIGNAL direction;
   datetime c2Time;
};
ClosedSetupKey g_closedSetupKeys[];
int g_closedSetupKeyCount=0;
#define MAX_CLOSED_SETUP_KEYS 10000

bool IsSetupKeyClosed(string symbol,ENUM_TIMEFRAMES timeframe,
                      ENUM_CRT_SIGNAL direction,datetime c2Time)
{
   for(int n=0;n<g_closedSetupKeyCount;n++)
   {
      if(g_closedSetupKeys[n].symbol==symbol &&
         g_closedSetupKeys[n].timeframe==timeframe &&
         g_closedSetupKeys[n].direction==direction &&
         g_closedSetupKeys[n].c2Time==c2Time)
         return true;
   }
   return false;
}

void RememberClosedSetupKey(string symbol,ENUM_TIMEFRAMES timeframe,
                             ENUM_CRT_SIGNAL direction,datetime c2Time)
{
   if(c2Time<=0 || IsSetupKeyClosed(symbol,timeframe,direction,c2Time))
      return;

   // Keep the most recent keys; older entries are beyond the scanner's
   // practical history window and can safely be discarded.
   if(g_closedSetupKeyCount>=MAX_CLOSED_SETUP_KEYS)
   {
      for(int n=1;n<g_closedSetupKeyCount;n++)
         g_closedSetupKeys[n-1]=g_closedSetupKeys[n];
      g_closedSetupKeyCount--;
      ArrayResize(g_closedSetupKeys,g_closedSetupKeyCount);
   }

   if(ArrayResize(g_closedSetupKeys,g_closedSetupKeyCount+1)!=g_closedSetupKeyCount+1)
      return;

   g_closedSetupKeys[g_closedSetupKeyCount].symbol=symbol;
   g_closedSetupKeys[g_closedSetupKeyCount].timeframe=timeframe;
   g_closedSetupKeys[g_closedSetupKeyCount].direction=direction;
   g_closedSetupKeys[g_closedSetupKeyCount].c2Time=c2Time;
   g_closedSetupKeyCount++;
}



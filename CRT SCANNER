//------------------------- SETUPS OF ONE SYMBOL --------------------//
// Fills out[] with the state indexes of the symbol's active setups,
// best score first, then higher timeframe first.
int CollectRowSetups(int symbolIndex,int &out[])
{
   ArrayResize(out,0);

   int n=0;

   for(int t=0;t<g_timeframeCount;t++)
   {
      int idx=symbolIndex*g_timeframeCount+t;

      if(idx>=g_stateCount)
         break;

      if(!g_states[idx].setupActive)
         continue;

      ArrayResize(out,n+1);
      out[n]=idx;
      n++;
   }

   for(int a=0;a<n-1;a++)
   {
      for(int b=a+1;b<n;b++)
      {
         bool swap=false;

         if(g_states[out[b]].setupScore>g_states[out[a]].setupScore)
            swap=true;
         else if(g_states[out[b]].setupScore==g_states[out[a]].setupScore &&
                 PeriodSeconds(g_states[out[b]].timeframe)>
                 PeriodSeconds(g_states[out[a]].timeframe))
            swap=true;

         if(swap)
         {
            int temp=out[a];
            out[a]=out[b];
            out[b]=temp;
         }
      }
   }

   return n;
}


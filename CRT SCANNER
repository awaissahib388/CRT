// Live result of a setup in R (entry = 0R, stop loss = -1R).
bool LiveR(int si,double &rValue)
{
   bool bull=(g_states[si].setupDir==CRT_BULL);

   double price=SymbolInfoDouble(g_states[si].symbol,
                                 bull ? SYMBOL_BID : SYMBOL_ASK);

   double risk=MathAbs(g_states[si].setupEntry-g_states[si].setupSL);

   if(price<=0.0 || risk<=0.0)
   {
      rValue=0.0;
      return false;
   }

   if(bull)
      rValue=(price-g_states[si].setupEntry)/risk;
   else
      rValue=(g_states[si].setupEntry-price)/risk;

   return true;
}

// Position of a price on the SL -> TP2 bar (0.0 .. 1.0).
double BarPos(int si,double price)
{
   bool bull=(g_states[si].setupDir==CRT_BULL);

   double sl=g_states[si].setupSL;
   double tp=g_states[si].setupTP;

   double span=(bull ? tp-sl : sl-tp);

   if(span<=0.0)
      return 0.0;

   double f=(bull ? (price-sl)/span : (sl-price)/span);

   return MathMax(0.0,MathMin(1.0,f));
}


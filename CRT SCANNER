   text+="FVG TOUCH: "+PAStatus(checked,(f.bullFVG || f.bearFVG))+" | IFVG: "+PAStatus(checked,(f.bullIFVG || f.bearIFVG))+"\n";
   text+="VI: "+PAStatus(checked,(f.bullVI || f.bearVI))+" | KISSING: "+PAStatus(checked,f.kissingCandle)+"\n";
   text+="ENGULFING: "+PAStatus(checked,(f.bullishEngulf || f.bearishEngulf))+" | FAILED BREAK: "+PAStatus(checked,(f.failedBreakUp || f.failedBreakDown))+"\n";
   text+="QML: "+PAStatus(checked,(f.bullQML || f.bearQML))+" | ENGULF FLIP: "+PAStatus(checked,(f.bullEngulfFlip || f.bearEngulfFlip))+"\n";
   text+="SUPPLY: "+PAStatus(checked,f.supplyActive)+" | DEMAND: "+PAStatus(checked,f.demandActive)+"\n";

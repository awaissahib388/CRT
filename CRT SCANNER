//------------------------- CRT FVG DIRECTION PERMISSION ------------//
bool IsHistoryFVGPermitted(ENUM_CRT_SIGNAL signal,
                           bool bullishFVG)
{
   if(signal==CRT_BULL)
   {
      return IsFVGDirectionPermitted(
         InpBullCRT_FVGPermission,
         bullishFVG
      );
   }

   if(signal==CRT_BEAR)
   {
      return IsFVGDirectionPermitted(
         InpBearCRT_FVGPermission,
         bullishFVG
      );
   }

   if(signal==CRT_DOUBLE)
   {
      bool bullPermission=
         IsFVGDirectionPermitted(
            InpBullCRT_FVGPermission,
            bullishFVG
         );

      bool bearPermission=
         IsFVGDirectionPermitted(
            InpBearCRT_FVGPermission,
            bullishFVG
         );

      return (bullPermission || bearPermission);
   }

   return false;
}

//------------------------- DRAW LINKED FVG HISTORY -----------------//
void DrawLinkedFVGsForHistory(int historyIndex)
{
   if(historyIndex<0 ||
      historyIndex>=g_crtHistoryCount)
      return;

   CRTHistory item=g_crtHistory[historyIndex];

   if(!IsCRTVisibleOnChart(item.timeframe))
      return;

   ENUM_TIMEFRAMES htf=
      FindNearestHigherTF(item.timeframe);

   if(htf==PERIOD_CURRENT)
      return;

   int lookback=InpFVGLookback;

   if(lookback<5)
      lookback=5;

   int extension=InpFVGExtendBars;

   if(extension<1)
      extension=1;

   int maxObjects=InpFVGObjectsPerTF;

   if(maxObjects<1)
      maxObjects=1;

   int htfSeconds=PeriodSeconds(htf);

   if(htfSeconds<=0)
      return;

   // IMPORTANT:
   // Copy the HTF history around this CRT's C2 time.
   // Do not copy only the latest HTF bars, because older
   // retained CRT events may be outside that recent window.
   datetime rangeStart=
      item.c2Time-(datetime)(htfSeconds*(lookback+5));

   datetime rangeEnd=item.c2Time;

   MqlRates rates[];
   ArraySetAsSeries(rates,true);

   int copied=CopyRates(
      item.symbol,
      htf,
      rangeStart,
      rangeEnd,
      rates
   );

   if(copied<5)
      return;

   int maxIndex=(int)MathMin(lookback,copied-3);
   int drawn=0;

   for(int i=1;i<=maxIndex && drawn<maxObjects;i++)
   {
      int older=i+2;

      // The third candle must be completely closed by C2 open.
      datetime formedTime=rates[i].time+htfSeconds;

      if(formedTime>item.c2Time)
         continue;

      bool bullish=
         rates[older].high<rates[i].low;

      bool bearish=
         rates[older].low>rates[i].high;

      if(!bullish && !bearish)
         continue;

      if(!IsHistoryFVGPermitted(item.signal,bullish))
         continue;

      double zoneLow=0.0;
      double zoneHigh=0.0;

      if(bullish)
      {
         zoneLow=rates[older].high;
         zoneHigh=rates[i].low;
      }
      else
      {
         zoneLow=rates[i].high;
         zoneHigh=rates[older].low;
      }

      if(!IsFVGStillValid(
            rates,
            i,
            bullish,
            zoneLow,
            zoneHigh,
            item.c2Time,
            htf))
         continue;

      bool touches=
         item.c2High>=zoneLow &&
         item.c2Low<=zoneHigh;

      if(!touches)
         continue;

      datetime endTime=
         TimeCurrent()+
         (datetime)(PeriodSeconds(htf)*extension);

      DrawFVGRectangle(
         item.timeframe,
         item.c2Time,
         htf,
         formedTime,
         endTime,
         zoneLow,
         zoneHigh,
         bullish
      );

      drawn++;
   }
}


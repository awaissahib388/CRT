   text+="LIQUIDITY SWEEP: "+PAStatus(checked,(f.bullSweep || f.bearSweep))+"\n";
   text+="IDM: "+PAStatus(checked,(f.bullInducement || f.bearInducement))+" | DOL: "+(checked && f.dolPrice>0.0 ? DoubleToString(f.dolPrice,digits) : (checked ? "NOT FOUND" : "NOT CHECKED"))+"\n";
